+}
+
+.btn-add-node:hover {
+    background: var(--wa-teal);
+    color: white;
+    border-color: var(--wa-teal);
+}
+
+/* Trigger Card */
+.flow-trigger-card {
+    background: var(--bg-card);
+    border: 1px solid var(--border-color);
+    border-radius: 10px;
+    padding: 12px;
