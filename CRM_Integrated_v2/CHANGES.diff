+
+@login_required
+def mark_lead_called_back(request, lead_id):
+    """'Mark called back' button on the lead pages: clears missed-call callbacks + completes their follow-ups."""
+    from django.utils.http import url_has_allowed_host_and_scheme
+    from .sync_services import add_lead_note, mark_called_back
+
+    if request.method != 'POST':
+        return redirect(_lead_detail_url_name(request.user), pk=lead_id)
+    lead = get_object_or_404(Lead, pk=lead_id)
+    if not can_access_lead(request.user, lead):
+        raise PermissionDenied("Permission denied: You are not authorized to update this lead.")
+
+    n = mark_called_back(lead, by=request.user)
+    if n:
+        add_lead_note(lead, f"✅ Missed Google call marked as called back by "
+                            f"{request.user.get_full_name() or request.user.username}")
+        log_activity(user=request.user, action="Missed Call Called Back",
+                     description=f"Marked {n} missed Google call(s) for '{lead.name}' as called back.",
+                     object_type="Lead", object_id=lead.pk, request=request)
+        messages.success(request, "Marked as called back.")
+    else:
+        messages.info(request, "No pending missed calls for this lead.")
+
+    nxt = request.POST.get('next') or request.META.get('HTTP_REFERER')
