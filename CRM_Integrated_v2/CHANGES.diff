+    <script>
+        let allFlows = [];
+
+        function showToast(msg, duration = 3000) {
+            const toast = document.getElementById('toastNotification');
+            const msgEl = document.getElementById('toastMessage');
+            if (!toast || !msgEl) return;
+            msgEl.textContent = msg;
+            toast.classList.add('visible');
+            setTimeout(() => toast.classList.remove('visible'), duration);
+        }
+
+        async function fetchAutomations() {
+            try {
+                const res = await fetch('/api/flows/');
+                if (!res.ok) throw new Error('Failed to load flows');
+                allFlows = await res.json();
+                renderFlows(allFlows);
+            } catch (err) {
+                console.error(err);
+                showToast('Failed to load automations.');
+            }
+        }
+
+        function renderFlows(flows) {
+            const grid = document.getElementById('flowsGridContainer');
+            const empty = document.getElementById('emptyFlowsBox');
+            const countLabel = document.getElementById('flowsCountLabel');
+
+            if (!flows || flows.length === 0) {
+                grid.style.display = 'none';
+                empty.style.display = 'flex';
+                countLabel.textContent = '0 automations';
+                return;
+            }
+
+            grid.style.display = 'grid';
+            empty.style.display = 'none';
+            countLabel.textContent = `${flows.length} automation${flows.length === 1 ? '' : 's'}`;
+
+            grid.innerHTML = flows.map(f => {
+                const isPublished = f.status === 'published';
+                const triggerDisplay = f.trigger_type === 'first_incoming_message'
+                    ? '⚡ First Incoming Message'
+                    : `🔑 Keyword (${f.trigger_keywords || 'default'})`;
+
+                return `
+                    <div class="flow-card" data-id="${f.id}" data-name="${(f.name || '').toLowerCase()}">
+                        <div class="flow-card-header">
+                            <div class="flow-card-info">
+                                <h3 class="flow-card-title">${escapeHtml(f.name)}</h3>
+                                <span class="flow-card-trigger">${triggerDisplay}</span>
