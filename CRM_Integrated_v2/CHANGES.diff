+    if user.is_sales_head_user:
+        return 'manager_lead_detail'
+    if user.is_branch_head_user:
+        return 'branch_head_lead_detail'
+    if user.is_counselor_user:
+        return 'counselor_lead_detail'
+    return 'telecaller_lead_detail'
