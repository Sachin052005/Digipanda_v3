+{% load calls_tags %}
+{% comment %}
+  Shared by the admin, manager, branch head, counselor and telecaller lead pages.
+  Needs: lead, call_recordings (lead.drive_recordings), request.
+  Shows: WhatsApp chats, Facebook Lead Ad submissions, Google Ads calls and call recordings (CRM Call Sync app).
+{% endcomment %}
+{% google_calls_for lead as google_calls %}
+{% pending_callbacks_for lead as pending_callbacks %}
+{% whatsapp_chats_for lead as wa_chats %}
+{% facebook_entries_for lead as fb_entries %}
+
+{% if wa_chats or fb_entries %}
+<!-- WHATSAPP + FACEBOOK -->
+<div class="crm-card" style="margin-top: 24px;">
+  <div class="crm-card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 10px;">
+    <h3 style="display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1.15rem; font-weight: 700;">
+      <span>💬</span> WHATSAPP &amp; FACEBOOK
+    </h3>
+    {% if wa_chats %}
+    <a href="{% url 'inbox' %}?phone={{ lead.phone|urlencode }}" class="btn btn-sm btn-primary" style="font-weight: 600; text-decoration: none;">Open WhatsApp chat</a>
+    {% endif %}
+  </div>
+  <div class="crm-card-body" style="padding: 16px 24px; display: flex; flex-direction: column; gap: 14px;">
+    {% for c in wa_chats %}
+    <div style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 0.9rem;">
+      <div>
+        <strong>WhatsApp</strong> · {{ c.business_account.name|default:"WhatsApp" }}
+        <span style="color: var(--text-muted);">({{ c.phone_number }})</span><br>
+        <span style="color: var(--text-muted);">Last message {{ c.last_message_time|date:"d M Y, h:i A"|default:"—" }}:</span> {{ c.last_message|truncatechars:90 }}
+      </div>
+      <a href="{% url 'inbox' %}?conversation={{ c.pk }}" class="btn btn-sm btn-secondary" style="align-self: center; text-decoration: none;">Open chat</a>
+    </div>
+    {% endfor %}
+    {% for fb in fb_entries %}
+    <div style="font-size: 0.9rem;">
+      <strong>📘 Facebook Lead Ad</strong> · {{ fb.created_on_facebook|default:fb.received_at|date:"d M Y, h:i A" }}<br>
+      <span style="color: var(--text-muted);">Form:</span> {{ fb.form_name|default:"—" }}
+      {% if fb.ad_name %} · <span style="color: var(--text-muted);">Ad:</span> {{ fb.ad_name }}{% endif %}
+      {% if fb.campaign_name %} · <span style="color: var(--text-muted);">Campaign:</span> {{ fb.campaign_name }}{% endif %}
+      {% if fb.all_answers %}
+      <details style="margin-top: 4px;"><summary style="cursor: pointer; color: var(--color-primary, #2563eb);">All form answers</summary>
+        <ul style="margin: 6px 0 0; padding-left: 18px;">{% for k, v in fb.all_answers.items %}<li><strong>{{ k }}</strong>: {{ v }}</li>{% endfor %}</ul>
+      </details>
+      {% endif %}
+    </div>
+    {% endfor %}
+  </div>
+</div>
+{% endif %}
+
+{% if google_calls %}
+<!-- GOOGLE ADS CALLS (CRM Call Sync app) -->
+<div class="crm-card" style="margin-top: 24px;">
+  <div class="crm-card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 10px;">
+    <h3 style="display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1.15rem; font-weight: 700;">
+      <span>📞</span> GOOGLE ADS CALLS ({{ google_calls|length }})
+    </h3>
+    {% if pending_callbacks %}
+      <form method="post" action="{% url 'mark_lead_called_back' lead.pk %}" style="margin: 0; display: flex; align-items: center; gap: 10px;">
+        {% csrf_token %}
+        <input type="hidden" name="next" value="{{ request.get_full_path }}">
+        <span class="badge" style="background: #fee2e2; color: #b91c1c; font-weight: 700;">📵 {{ pending_callbacks }} missed call{{ pending_callbacks|pluralize }} to call back</span>
+        <button type="submit" class="btn btn-sm btn-primary" style="font-weight: 600;">✅ Mark called back</button>
+      </form>
+    {% endif %}
+  </div>
+  <div class="crm-card-body" style="padding: 12px 24px;">
+    <div class="table-responsive">
+      <table class="crm-table" style="width: 100%;">
+        <thead>
+          <tr>
+            <th>When</th>
+            <th>Call</th>
+            <th>Duration</th>
+            <th>Received by</th>
+            <th>Call back</th>
+          </tr>
+        </thead>
+        <tbody>
+          {% for ev in google_calls %}
+          <tr>
+            <td>{{ ev.started_at|date:"d M Y, h:i A" }}</td>
+            <td>
+              {% if ev.is_answered %}
+                <span class="badge" style="background: #dcfce7; color: #15803d; font-weight: 700;">Answered</span>
+              {% else %}
+                <span class="badge" style="background: #fee2e2; color: #b91c1c; font-weight: 700;">{{ ev.get_call_type_display }}</span>
+              {% endif %}
+              {% if ev.is_new_lead %}<span class="badge" style="background: #e0f2fe; color: #0369a1; font-weight: 600;">New lead</span>{% endif %}
+            </td>
+            <td>{{ ev.formatted_duration }}</td>
+            <td>{% if ev.telecaller %}{{ ev.telecaller.get_full_name|default:ev.telecaller.username }}{% else %}—{% endif %}</td>
+            <td>
+              {% if ev.needs_callback %}
+                <strong style="color: #b91c1c;">Pending</strong>{% if ev.followup %} · follow-up {{ ev.followup.follow_up_date|date:"d M" }} {{ ev.followup.follow_up_time|time:"h:i A" }}{% endif %}
+              {% elif ev.called_back_at %}
+                Called back {{ ev.called_back_at|date:"d M, h:i A" }}{% if ev.called_back_by %} by {{ ev.called_back_by }}{% endif %}
+              {% else %}
+                <span style="color: var(--text-muted);">—</span>
+              {% endif %}
+            </td>
+          </tr>
+          {% endfor %}
+        </tbody>
+      </table>
+    </div>
+  </div>
+</div>
+{% endif %}
+
+<!-- CALL RECORDINGS (CRM Call Sync app) -->
+<div class="crm-card" style="margin-top: 24px;">
+  <div class="crm-card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 10px;">
+    <h3 style="display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1.15rem; font-weight: 700;">
+      <span>🎙</span> CALL RECORDINGS ({{ call_recordings|length }})
+    </h3>
+    <span class="badge" style="background: #e0f2fe; color: #0369a1; font-weight: 700;">Source: CRM Call Sync app</span>
+  </div>
+  <div class="crm-card-body" style="padding: 20px 24px;">
+    {% if call_recordings %}
+      <div style="display: flex; flex-direction: column; gap: 16px;">
+        {% for rec in call_recordings %}
+        <div style="background: var(--bg-body); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 18px 20px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;">
+          <div style="min-width: 280px; flex: 1;">
+            <div style="font-weight: 700; color: var(--text-main); font-size: 1.05rem; word-break: break-all; display: flex; align-items: center; gap: 8px;">
+              <span>{{ forloop.counter }}.</span> 🎙 {{ rec.file_name }}
+            </div>
+
+            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-top: 10px; font-size: 0.85rem;">
+              <div>
+                <span style="color: var(--text-muted); display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Source:</span>
+                {% if rec.is_app_recording %}
+                  <strong style="color: var(--text-main);">📱 Call Sync app</strong>
+                {% else %}
+                  <strong style="color: var(--text-main);">Archived recording</strong>
+                {% endif %}
+              </div>
+              <div>
+                <span style="color: var(--text-muted); display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Call time:</span>
+                <strong style="color: var(--text-main);">{{ rec.recording_date|date:"d M Y, h:i A"|default:"—" }}</strong>
+              </div>
+              {% if rec.is_app_recording %}
+              <div>
+                <span style="color: var(--text-muted); display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Direction:</span>
+                <strong style="color: var(--text-main);">{{ rec.get_direction_display }}</strong>
+              </div>
+              {% endif %}
+              <div>
+                <span style="color: var(--text-muted); display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Mobile:</span>
+                <strong style="font-family: monospace; color: var(--text-main);">{{ rec.normalized_mobile_number|default:lead.phone }}</strong>
+              </div>
+              <div>
+                <span style="color: var(--text-muted); display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Duration:</span>
+                <strong style="color: var(--text-main);">{{ rec.duration|default:"—" }}</strong>
+              </div>
+              <div>
+                <span style="color: var(--text-muted); display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">By:</span>
+                <strong style="color: var(--text-main);">{% if rec.telecaller %}{{ rec.telecaller.get_full_name|default:rec.telecaller.username }}{% else %}—{% endif %}</strong>
+              </div>
+              <div>
+                <span style="color: var(--text-muted); display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 600;">Match Status:</span>
+                <span class="badge" style="background: #dcfce7; color: #15803d; font-weight: 700; padding: 2px 8px; font-size: 0.78rem;">
+                  🟢 Automatically Matched
+                </span>
+                <span style="display: none;">🟢 Matched</span>
+              </div>
+            </div>
+          </div>
+
+          <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
+            {% if rec.has_audio %}
+            <audio controls id="rec-audio-{{ rec.pk }}" preload="none" style="height: 36px; max-width: 220px;">
+              <source src="{% url 'drive_stream_recording' rec.pk %}" type="{{ rec.mime_type }}">
+              Audio tag not supported.
+            </audio>
+            <button type="button" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('rec-audio-{{ rec.pk }}').play()" style="display: inline-flex; align-items: center; gap: 4px; font-weight: 600;">
+              ▶ Play
+            </button>
+            {% else %}
+            <span style="color: var(--text-muted); font-size: 0.85rem;">No recording available</span>
+            {% endif %}
+
+          </div>
+        </div>
+        {% endfor %}
+      </div>
+    {% else %}
+      <div style="text-align: center; color: var(--text-muted); padding: 24px 16px;">
+        <p style="margin: 0; font-size: 0.9rem;">No call recordings found for this lead yet.</p>
+        <p style="margin: 4px 0 0; font-size: 0.8rem; color: var(--text-muted);">
+          Calls to <strong>{{ lead.phone }}</strong> recorded on telecaller phones (CRM Call Sync app) will appear here automatically.
+        </p>
+      </div>
+    {% endif %}
+  </div>
+</div>
diff --git a/templates/calls/recordings_list.html b/templates/calls/recordings_list.html
new file mode 100644
index 0000000..741f4bd
--- /dev/null
+++ b/templates/calls/recordings_list.html
@@ -0,0 +1,144 @@
+{% extends 'base.html' %}
+{% block title %}Call Recordings - TECHPANDA CRM{% endblock %}
+
+{% block content %}
+<div class="page-header">
+  <div class="page-title-group">
+    <h1>Call Recordings</h1>
+    <p>Recordings uploaded automatically from telecaller phones by the CRM Call Sync app</p>
+  </div>
+  {% if can_see_unmatched and unmatched %}
+  <form method="post" action="{% url 'recordings_retry_match' %}" style="margin: 0;">
+    {% csrf_token %}
+    <button type="submit" class="btn btn-secondary" title="Link unmatched recordings to leads added since">⟳ Re-check unmatched</button>
+  </form>
+  {% endif %}
+</div>
+
+<div class="kpi-grid">
+  <div class="kpi-card">
+    <div class="kpi-info"><h4>Recordings</h4><div class="kpi-value">{{ total }}</div></div>
+    <div class="kpi-icon-wrap blue"><circle cx="12" cy="12" r="10"></circle></div>
+  </div>
+  <div class="kpi-card">
+    <div class="kpi-info"><h4>Today</h4><div class="kpi-value">{{ today }}</div></div>
+    <div class="kpi-icon-wrap green"><polyline points="20 6 9 17 4 12"></polyline></div>
+  </div>
+  {% if can_see_unmatched %}
+  <div class="kpi-card">
+    <div class="kpi-info"><h4>Not matched to a lead</h4><div class="kpi-value" {% if unmatched %}style="color: var(--warning, #b45309);"{% endif %}>{{ unmatched }}</div></div>
+    <div class="kpi-icon-wrap amber"><polyline points="12 6 12 12 16 14"></polyline></div>
+  </div>
+  {% endif %}
+</div>
+
+<div class="filter-card">
+  <form method="get" class="filter-form">
+    <div class="filter-col">
+      <label>Search</label>
+      <input type="text" name="q" value="{{ f.q }}" class="form-control" placeholder="Lead name, phone or file name">
+    </div>
+    <div class="filter-col">
+      <label>Telecaller</label>
+      <select name="telecaller" class="form-select">
+        <option value="">All</option>
+        {% for t in telecallers %}<option value="{{ t.pk }}" {% if f.telecaller == t.pk|stringformat:"d" %}selected{% endif %}>{{ t.get_full_name|default:t.username }}</option>{% endfor %}
+      </select>
+    </div>
+    <div class="filter-col">
+      <label>Direction</label>
+      <select name="direction" class="form-select">
+        <option value="">All</option>
+        <option value="outgoing" {% if f.direction == 'outgoing' %}selected{% endif %}>Outgoing</option>
+        <option value="incoming" {% if f.direction == 'incoming' %}selected{% endif %}>Incoming</option>
+        <option value="unknown" {% if f.direction == 'unknown' %}selected{% endif %}>Unknown</option>
+      </select>
+    </div>
+    {% if can_see_unmatched %}
+    <div class="filter-col">
+      <label>Lead</label>
+      <select name="match" class="form-select">
+        <option value="">All</option>
+        <option value="MATCHED" {% if f.match == 'MATCHED' %}selected{% endif %}>Matched</option>
+        <option value="UNMATCHED" {% if f.match == 'UNMATCHED' %}selected{% endif %}>Not matched</option>
+      </select>
+    </div>
+    {% endif %}
+    <div class="filter-col">
+      <label>From</label>
+      <input type="date" name="date_from" value="{{ f.date_from }}" class="form-control">
+    </div>
+    <div class="filter-col">
+      <label>To</label>
+      <input type="date" name="date_to" value="{{ f.date_to }}" class="form-control">
+    </div>
+    <div style="display: flex; gap: 8px;">
+      <button type="submit" class="btn btn-primary">Filter</button>
+      <a href="{% url 'call_recordings_list' %}" class="btn btn-secondary">Reset</a>
+    </div>
+  </form>
+</div>
+
+<div class="crm-card">
+  <div class="crm-card-body" style="padding: 12px 24px;">
+    {% if page_obj.object_list %}
+    <div class="table-responsive">
+      <table class="crm-table" style="width: 100%;">
+        <thead>
+          <tr>
+            <th>Call time</th>
+            <th>Lead</th>
+            <th>Phone</th>
+            <th>Direction</th>
+            <th>Duration</th>
+            <th>Telecaller</th>
+            <th>Listen</th>
+          </tr>
+        </thead>
+        <tbody>
+          {% for rec in page_obj.object_list %}
+          <tr>
+            <td>{{ rec.recording_date|date:"d M Y, h:i A"|default:"—" }}</td>
+            <td>
+              {% if rec.lead %}
+                <a href="{% url lead_url_name rec.lead.pk %}" style="font-weight: 600;">{{ rec.lead.name }}</a>
+                {% if rec.lead.branch %}<br><span style="color: var(--text-muted); font-size: 0.8rem;">{{ rec.lead.branch.name }}</span>{% endif %}
+              {% else %}
+                <span class="badge" style="background: #fef3c7; color: #b45309; font-weight: 600;">Not matched</span>
+                <br><span style="color: var(--text-muted); font-size: 0.78rem;">{{ rec.unmatched_reason }}</span>
+              {% endif %}
+            </td>
+            <td style="font-family: monospace;">{{ rec.normalized_mobile_number|default:rec.mobile_number|default:"—" }}</td>
+            <td>{{ rec.get_direction_display }}</td>
+            <td>{{ rec.duration|default:"—" }}</td>
+            <td>{% if rec.telecaller %}{{ rec.telecaller.get_full_name|default:rec.telecaller.username }}{% else %}—{% endif %}</td>
+            <td>
+              {% if rec.has_audio %}
+              <audio controls preload="none" style="height: 32px; max-width: 240px;">
+                <source src="{% url 'drive_stream_recording' rec.pk %}" type="{{ rec.mime_type }}">
+              </audio>
+              {% else %}
+              <span style="color: var(--text-muted); font-size: 0.85rem;">No audio</span>
+              {% endif %}
+            </td>
+          </tr>
+          {% endfor %}
+        </tbody>
+      </table>
+    </div>
+    {% if page_obj.has_other_pages %}
+    <div style="display: flex; gap: 8px; justify-content: center; padding: 12px 0;">
+      {% if page_obj.has_previous %}<a class="btn btn-sm btn-secondary" href="?{{ query_string }}&page={{ page_obj.previous_page_number }}">← Previous</a>{% endif %}
+      <span style="align-self: center;">Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}</span>
+      {% if page_obj.has_next %}<a class="btn btn-sm btn-secondary" href="?{{ query_string }}&page={{ page_obj.next_page_number }}">Next →</a>{% endif %}
+    </div>
+    {% endif %}
+    {% else %}
+    <div style="text-align: center; color: var(--text-muted); padding: 32px 16px;">
+      <p style="margin: 0;">No call recordings yet.</p>
+      <p style="margin: 4px 0 0; font-size: 0.8rem;">Install the CRM Call Sync app on telecaller phones: every recorded call uploads within about 30 seconds.</p>
+    </div>
+    {% endif %}
+  </div>
+</div>
+{% endblock %}
