+        };
+        document.getElementById('btnCloseNewModal').onclick = () => {
+            createModal.style.display = 'none';
+        };
+        document.getElementById('btnCancelCreateModal').onclick = () => {
+            createModal.style.display = 'none';
+        };
+
+        document.getElementById('btnConfirmCreateFlow').onclick = async () => {
