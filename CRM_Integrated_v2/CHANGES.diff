+    height: 14px;
+    border-radius: 50%;
+    background: #0f172a;
+    border: 2px solid #64748b;
+    pointer-events: auto;
+    cursor: crosshair;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s, background-color 0.15s;
+    z-index: 10;
+}
+
+.node-port::after {
+    content: '';
+    width: 4px;
+    height: 4px;
+    border-radius: 50%;
+    background: #64748b;
+    transition: background-color 0.15s;
+}
+
+.node-port:hover {
+    transform: scale(1.35);
+    border-color: #38bdf8;
+    background: #0369a1;
+    box-shadow: 0 0 10px rgba(56, 189, 248, 0.7);
+}
+
+.node-port:hover::after {
+    background: #ffffff;
+}
+
+.node-port.port-input {
+    left: -7px;
+    top: 50%;
+    transform: translateY(-50%);
+}
+
+.node-port.port-input:hover {
+    transform: translateY(-50%) scale(1.35);
+}
+
+.node-port.port-input.valid-target {
+    border-color: #10b981;
+    background: #059669;
+    box-shadow: 0 0 12px rgba(16, 185, 129, 0.8);
+    transform: translateY(-50%) scale(1.4);
+}
+
+.node-port.port-output {
+    right: -7px;
+    top: 50%;
+    transform: translateY(-50%);
+}
+
+.node-port.port-output:hover {
+    transform: translateY(-50%) scale(1.35);
+}
+
+.node-port.port-yes {
+    border-color: #10b981;
+}
+
+.node-port.port-yes:hover {
+    background: #059669;
+    border-color: #34d399;
+}
+
+.node-port.port-no {
+    border-color: #ef4444;
+}
+
+.node-port.port-no:hover {
+    background: #dc2626;
+    border-color: #f87171;
+}
+
+/* Branch Port Badges */
+.port-badge {
+    position: absolute;
+    right: 14px;
+    font-size: 10px;
+    font-weight: 700;
+    padding: 1px 6px;
+    border-radius: 4px;
+    pointer-events: none;
+    letter-spacing: 0.5px;
+    text-transform: uppercase;
+    transform: translateY(-50%);
+}
+
+.port-badge.badge-yes {
+    background: rgba(16, 185, 129, 0.2);
+    color: #34d399;
+    border: 1px solid rgba(16, 185, 129, 0.4);
+}
+
+.port-badge.badge-no {
+    background: rgba(239, 68, 68, 0.2);
+    color: #f87171;
+    border: 1px solid rgba(239, 68, 68, 0.4);
+}
+
+.port-badge.badge-opt {
+    background: rgba(139, 92, 246, 0.2);
+    color: #c4b5fd;
+    border: 1px solid rgba(139, 92, 246, 0.4);
+    max-width: 120px;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+/* Edge & SVG Connection Interaction */
+.canvas-svg-layer {
+    pointer-events: auto !important;
+}
+
+.connection-path-hitarea {
+    fill: none;
+    stroke: transparent;
+    stroke-width: 18;
+    cursor: pointer;
+    pointer-events: stroke;
+}
+
+.connection-path {
+    pointer-events: stroke;
+    cursor: pointer;
+    transition: stroke-width 0.15s, stroke 0.15s, filter 0.15s;
+}
+
+.connection-path:hover,
+.connection-path.selected {
+    stroke-width: 4.5 !important;
+    filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.8));
+}
+
+.connection-path.selected {
+    stroke: #f59e0b !important;
+    stroke-dasharray: 6 3;
+    animation: dash-flow 1s linear infinite;
+}
+
+@keyframes dash-flow {
+    from { stroke-dashoffset: 9; }
+    to { stroke-dashoffset: 0; }
+}
+
+/* Edge Delete Button */
+.edge-delete-btn {
+    position: absolute;
+    width: 22px;
+    height: 22px;
+    border-radius: 50%;
+    background: #ef4444;
+    color: white;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-size: 13px;
+    font-weight: 700;
+    cursor: pointer;
+    z-index: 50;
+    border: 2px solid #0f172a;
+    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
+    transform: translate(-50%, -50%);
+    transition: transform 0.15s, background-color 0.15s;
+}
+
+.edge-delete-btn:hover {
+    background: #dc2626;
+    transform: translate(-50%, -50%) scale(1.2);
+}
+
+/* Live dragging connection line */
+.connection-drag-path {
+    fill: none;
+    stroke: #38bdf8;
+    stroke-width: 3;
+    stroke-dasharray: 6 4;
+    animation: dash-flow 0.8s linear infinite;
+    pointer-events: none;
+}
+
+/* Simulation glow & Error badges */
+.flow-node.sim-active {
+    border-color: #10b981 !important;
+    box-shadow: 0 0 24px rgba(16, 185, 129, 0.7), var(--shadow-lg) !important;
+    transform: scale(1.02);
+}
+
+.node-error-badge {
+    position: absolute;
+    top: -8px;
+    right: -8px;
+    background: #ef4444;
+    color: white;
+    border-radius: 50%;
+    width: 20px;
+    height: 20px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-size: 11px;
+    font-weight: 800;
+    border: 2px solid var(--bg-card);
+    z-index: 15;
+    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
+}
+
+/* CRM steps */
+.icon-crm {
+    background: rgba(249, 115, 22, 0.15);
+}
+
+.crm-check {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    cursor: pointer;
+    font-weight: 500;
+}
+
+.crm-check input {
+    width: 16px;
+    height: 16px;
+    accent-color: var(--accent-blue);
+}
+
+.sim-crm-note {
+    align-self: center;
+    max-width: 90%;
+    margin: 6px auto;
+    padding: 4px 10px;
+    border-radius: 999px;
+    background: rgba(249, 115, 22, 0.12);
+    border: 1px dashed rgba(249, 115, 22, 0.5);
+    color: var(--text-secondary);
+    font-size: 11.5px;
+    text-align: center;
+}
diff --git a/chat/static/chat/css/inbox.css b/chat/static/chat/css/inbox.css
new file mode 100644
index 0000000..fd8a988
--- /dev/null
+++ b/chat/static/chat/css/inbox.css
@@ -0,0 +1,1412 @@
+/* ==========================================================================
+   WhatsApp CRM Inbox - Design System & Modern Styling
+   Strict 2-Column Responsive Layout: CONVERSATIONS (30%) & CHAT (70%)
+   ========================================================================== */
+
+:root {
+    /* Color Palette */
+    --bg-app: #eef2f5;
+    --bg-sidebar: #ffffff;
+    --bg-chat-header: #f0f2f5;
+    --bg-chat-body: #efeae2;
+    --bg-composer: #f0f2f5;
+    --bg-hover: #f5f6f6;
+    --bg-active: #eaeef2;
+    --bg-search-box: #f0f2f5;
+
+    /* Message Bubbles */
+    --bubble-incoming: #ffffff;
+    --bubble-incoming-text: #111b21;
+    --bubble-outgoing: #d9fdd3;
+    --bubble-outgoing-text: #111b21;
+    --bubble-shadow: 0 1px 0.5px rgba(11, 20, 26, 0.13);
+
+    /* Accents & Brand */
+    --accent-primary: #00a884;
+    --accent-hover: #008f6f;
+    --accent-subtle: #e7f8f4;
+    --accent-danger: #ea4335;
+    --badge-unread: #25d366;
+    --status-online: #25d366;
+
+    /* Ticks / Message Status */
+    --tick-sent: #8696a0;
+    --tick-delivered: #8696a0;
+    --tick-read: #53bdeb;
+
+    /* Typography & Borders */
+    --text-primary: #111b21;
+    --text-secondary: #667781;
+    --text-muted: #8696a0;
+    --border-subtle: #e9edef;
+    --border-strong: #d1d7db;
+
+    /* Layout & Sizing - Scaled for crisp 100% display */
+    --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+    --header-height: 56px;
+    --composer-min-height: 54px;
+    --transition-fast: 0.15s ease;
+    --transition-smooth: 0.25s ease;
+}
+
+/* --------------------------------------------------------------------------
+   Reset & Base
+   -------------------------------------------------------------------------- */
+* {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+}
+
+html, body {
+    height: 100%;
+    width: 100%;
+    overflow: hidden;
+    font-family: var(--font-sans);
+    background-color: var(--bg-app);
+    color: var(--text-primary);
+    -webkit-font-smoothing: antialiased;
+}
+
+/* --------------------------------------------------------------------------
+   App Container (2 Panels Only)
+   -------------------------------------------------------------------------- */
+.crm-app-container {
+    display: flex;
+    width: 100vw;
+    height: 100vh;
+    max-width: 100%;
+    background-color: var(--bg-sidebar);
+    position: relative;
+    overflow: hidden;
+}
+
+/* --------------------------------------------------------------------------
+   SECTION 1: CONVERSATIONS PANEL (30% desktop)
+   -------------------------------------------------------------------------- */
+.conversations-panel {
+    width: 30%;
+    min-width: 320px;
+    max-width: 480px;
+    height: 100%;
+    display: flex;
+    flex-direction: column;
+    background-color: var(--bg-sidebar);
+    border-right: 1px solid var(--border-subtle);
+    z-index: 10;
+    transition: transform var(--transition-smooth);
+}
+
+/* Panel Header */
+.panel-header {
+    height: var(--header-height);
+    min-height: var(--header-height);
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 0 16px;
+    background-color: var(--bg-chat-header);
+    border-bottom: 1px solid var(--border-subtle);
+}
+
+.conversations-header {
+    background-color: var(--bg-sidebar);
+}
+
+.header-branding {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+}
+
+.branding-badge {
+    width: 38px;
+    height: 38px;
+    border-radius: 10px;
+    background: linear-gradient(135deg, #00a884, #128c7e);
+    color: #ffffff;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    box-shadow: 0 2px 6px rgba(0, 168, 132, 0.25);
+}
+
+.panel-title {
+    font-size: 1.05rem;
+    font-weight: 700;
+    letter-spacing: 0.5px;
+    color: var(--text-primary);
+}
+
+.header-actions {
+    display: flex;
+    align-items: center;
+    gap: 4px;
+}
+
+/* Icon Button */
+.icon-btn {
+    background: none;
+    border: none;
+    color: var(--text-secondary);
+    width: 40px;
+    height: 40px;
+    border-radius: 50%;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    cursor: pointer;
+    transition: background-color var(--transition-fast), color var(--transition-fast);
+}
+
+.icon-btn:hover {
+    background-color: var(--bg-hover);
+    color: var(--text-primary);
+}
+
+.icon-btn:active {
+    transform: scale(0.96);
+}
+
+/* Business Account Switcher */
+.business-account-bar {
+    padding: 10px 16px 6px 16px;
+    background-color: #f7f9fa;
+    border-bottom: 1px solid var(--border-subtle);
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+}
+
+.business-account-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+}
+
+.business-account-label {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    font-size: 0.76rem;
+    font-weight: 700;
+    color: var(--text-secondary);
+    text-transform: uppercase;
+    letter-spacing: 0.5px;
+}
+
+.add-line-btn {
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    background: transparent;
+    border: 1px dashed var(--primary-teal);
+    color: var(--primary-teal);
+    font-size: 0.72rem;
+    font-weight: 700;
+    padding: 2px 8px;
+    border-radius: 12px;
+    cursor: pointer;
+    transition: all var(--transition-fast);
+}
+
+.add-line-btn:hover {
+    background-color: var(--primary-teal);
+    color: #ffffff;
+}
+
+.business-status-pill {
+    background-color: rgba(37, 211, 102, 0.15);
+    color: #128c7e;
+    font-size: 0.7rem;
+    font-weight: 700;
+    padding: 2px 8px;
+    border-radius: 10px;
+}
+
+.business-select-wrap {
+    position: relative;
+    width: 100%;
+}
+
+.business-account-select {
+    width: 100%;
+    padding: 8px 12px;
+    background-color: #ffffff;
+    border: 1px solid var(--border-strong);
+    border-radius: 8px;
+    font-family: inherit;
+    font-size: 0.88rem;
+    font-weight: 600;
+    color: var(--text-primary);
+    outline: none;
+    cursor: pointer;
+    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
+}
+
+.business-account-select:focus {
+    border-color: var(--accent-primary);
+    box-shadow: 0 0 0 2px rgba(0, 168, 132, 0.2);
+}
+
+/* Search Area */
+.conversations-search-wrap {
+    padding: 10px 16px;
+    background-color: var(--bg-sidebar);
+}
+
+.search-input-box {
+    display: flex;
+    align-items: center;
+    background-color: var(--bg-search-box);
+    border-radius: 8px;
+    padding: 0 12px;
+    height: 38px;
+    border: 1px solid transparent;
+    transition: border-color var(--transition-fast), background-color var(--transition-fast);
+}
+
+.search-input-box:focus-within {
+    background-color: #ffffff;
+    border-color: var(--accent-primary);
+    box-shadow: 0 0 0 1px var(--accent-primary);
+}
+
+.search-icon {
+    color: var(--text-muted);
+    margin-right: 8px;
+    flex-shrink: 0;
+}
+
+.search-input-box input {
+    width: 100%;
+    border: none;
+    background: transparent;
+    font-size: 0.9rem;
+    font-family: inherit;
+    color: var(--text-primary);
+    outline: none;
+}
+
+.search-input-box input::placeholder {
+    color: var(--text-muted);
+}
+
+.search-clear-btn {
+    background: none;
+    border: none;
+    color: var(--text-muted);
+    font-size: 1.2rem;
+    cursor: pointer;
+    padding: 0 4px;
+}
+
+.search-clear-btn:hover {
+    color: var(--text-primary);
+}
+
+/* Filters */
+.conversations-filters {
+    display: flex;
+    gap: 8px;
+    padding: 4px 16px 12px 16px;
+    border-bottom: 1px solid var(--border-subtle);
+    background-color: var(--bg-sidebar);
+}
+
+.filter-tab {
+    padding: 6px 14px;
+    border-radius: 20px;
+    font-size: 0.82rem;
+    font-weight: 600;
+    font-family: inherit;
+    border: 1px solid var(--border-subtle);
+    background-color: #ffffff;
+    color: var(--text-secondary);
+    cursor: pointer;
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    transition: all var(--transition-fast);
+}
+
+.filter-tab:hover {
+    background-color: var(--bg-hover);
+    color: var(--text-primary);
+}
+
+.filter-tab.active {
+    background-color: var(--accent-subtle);
+    color: var(--accent-primary);
+    border-color: rgba(0, 168, 132, 0.3);
+}
+
+.filter-unread-count {
+    background-color: var(--accent-primary);
+    color: #ffffff;
+    font-size: 0.72rem;
+    font-weight: 700;
+    padding: 1px 6px;
+    border-radius: 10px;
+}
+
+/* Conversation List Scroll Container */
+.conversations-list-container {
+    flex: 1;
+    overflow-y: auto;
+    overflow-x: hidden;
+    position: relative;
+}
+
+.conversations-list-container::-webkit-scrollbar {
+    width: 6px;
+}
+
+.conversations-list-container::-webkit-scrollbar-thumb {
+    background-color: rgba(0, 0, 0, 0.15);
+    border-radius: 3px;
+}
+
+.conversations-list {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+}
+
+/* Single Conversation Item */
+.conversation-item {
+    display: flex;
+    align-items: center;
+    padding: 9px 14px;
+    cursor: pointer;
+    border-bottom: 1px solid rgba(233, 237, 239, 0.6);
+    transition: background-color var(--transition-fast);
+    position: relative;
+}
+
+.conversation-item:hover {
+    background-color: var(--bg-hover);
+}
+
+.conversation-item.active {
+    background-color: var(--bg-active);
+    border-left: 3.5px solid var(--accent-primary);
+    padding-left: 10.5px;
+}
+
+/* Avatars */
+.conv-avatar-wrap {
+    position: relative;
+    width: 42px;
+    height: 42px;
+    margin-right: 12px;
+    flex-shrink: 0;
+}
+
+.conv-avatar, .user-avatar {
+    width: 100%;
+    height: 100%;
+    border-radius: 50%;
+    background-color: #cbd5e1;
+    color: #334155;
+    font-weight: 700;
+    font-size: 0.9rem;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    overflow: hidden;
+    text-transform: uppercase;
+}
+
+.conv-avatar img, .user-avatar img {
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+}
+
+.conv-online-dot, .user-online-dot {
+    position: absolute;
+    bottom: 2px;
+    right: 2px;
+    width: 11px;
+    height: 11px;
+    border-radius: 50%;
+    background-color: var(--status-online);
+    border: 2px solid #ffffff;
+    display: none;
+}
+
+.conv-avatar-wrap.is-online .conv-online-dot,
+.user-avatar-wrap.is-online .user-online-dot {
+    display: block;
+}
+
+/* Conversation Text Details */
+.conv-content {
+    flex: 1;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    gap: 4px;
+}
+
+.conv-top-row {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+}
+
+.conv-name {
+    font-size: 0.98rem;
+    font-weight: 600;
+    color: var(--text-primary);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+.conv-time {
+    font-size: 0.76rem;
+    color: var(--text-muted);
+    font-weight: 500;
+    flex-shrink: 0;
+    margin-left: 8px;
+}
+
+.conversation-item.has-unread .conv-time {
+    color: var(--badge-unread);
+    font-weight: 600;
+}
+
+.conv-bottom-row {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+}
+
+.conv-preview {
+    font-size: 0.85rem;
+    color: var(--text-secondary);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    padding-right: 8px;
+}
+
+.conversation-item.has-unread .conv-preview {
+    color: var(--text-primary);
+    font-weight: 600;
+}
+
+.conv-badges {
+    display: flex;
+    align-items: center;
+    gap: 6px;
+    flex-shrink: 0;
+}
+
+.pin-indicator {
+    color: var(--text-muted);
+    font-size: 0.8rem;
+}
+
+.unread-badge {
+    background-color: var(--badge-unread);
+    color: #ffffff;
+    font-size: 0.72rem;
+    font-weight: 700;
+    min-width: 20px;
+    height: 20px;
+    border-radius: 10px;
+    padding: 0 6px;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    box-shadow: 0 1px 2px rgba(37, 211, 102, 0.3);
+}
+
+/* Loading & Empty States */
+.conversations-loading, .conversations-empty {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    padding: 48px 24px;
+    text-align: center;
+    color: var(--text-secondary);
+    gap: 12px;
+}
+
+.empty-icon {
+    font-size: 2.2rem;
+    margin-bottom: 4px;
+}
+
+.empty-title {
+    font-size: 1.05rem;
+    font-weight: 600;
+    color: var(--text-primary);
+}
+
+.empty-subtitle {
+    font-size: 0.85rem;
+    color: var(--text-muted);
+    max-width: 260px;
+}
+
+.spinner {
+    width: 28px;
+    height: 28px;
+    border: 3px solid rgba(0, 168, 132, 0.2);
+    border-top-color: var(--accent-primary);
+    border-radius: 50%;
+    animation: spin 0.8s linear infinite;
+}
+
+@keyframes spin {
+    to { transform: rotate(360deg); }
+}
+
+/* --------------------------------------------------------------------------
+   SECTION 2: CHAT PANEL (70% desktop)
+   -------------------------------------------------------------------------- */
+.chat-panel {
+    width: 70%;
+    flex: 1;
+    height: 100%;
+    display: flex;
+    flex-direction: column;
+    background-color: var(--bg-chat-body);
+    position: relative;
+    overflow: hidden;
+}
+
+/* Background Wallpaper Pattern */
+.chat-panel::before {
+    content: "";
+    position: absolute;
+    inset: 0;
+    background-image:
+        radial-gradient(#d1d7db 0.75px, transparent 0.75px),
+        radial-gradient(#d1d7db 0.75px, #efeae2 0.75px);
+    background-size: 30px 30px;
+    background-position: 0 0, 15px 15px;
+    opacity: 0.45;
+    pointer-events: none;
+    z-index: 0;
+}
+
+/* Chat Placeholder (Empty state when no chat selected) */
+.chat-placeholder {
+    height: 100%;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    text-align: center;
+    padding: 32px;
+    position: relative;
+    z-index: 1;
+}
+
+.placeholder-graphic {
+    margin-bottom: 24px;
+}
+
+.placeholder-circle {
+    width: 100px;
+    height: 100px;
+    border-radius: 50%;
+    background-color: #ffffff;
+    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    color: var(--accent-primary);
+}
+
+.placeholder-title {
+    font-size: 1.5rem;
+    font-weight: 700;
+    color: var(--text-primary);
+    margin-bottom: 8px;
+}
+
+.placeholder-text {
+    font-size: 0.95rem;
+    color: var(--text-secondary);
+    max-width: 420px;
+    line-height: 1.5;
+    margin-bottom: 24px;
+}
+
+.placeholder-badge {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    font-size: 0.8rem;
+    color: var(--text-muted);
+    background-color: rgba(255, 255, 255, 0.7);
+    padding: 6px 14px;
+    border-radius: 20px;
+    border: 1px solid var(--border-subtle);
+}
+
+/* Active Chat Interface */
+.chat-interface {
+    display: flex;
+    flex-direction: column;
+    width: 100%;
+    height: 100%;
+    position: relative;
+    z-index: 1;
+}
+
+/* 2.1 Chat Header */
+.chat-header {
+    background-color: var(--bg-chat-header);
+    border-bottom: 1px solid var(--border-subtle);
+    z-index: 5;
+}
+
+.chat-header-user {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    min-width: 0;
+}
+
+.back-btn {
+    display: none;
+    margin-right: -4px;
+}
+
+.user-avatar-wrap {
+    position: relative;
+    width: 42px;
+    height: 42px;
+    flex-shrink: 0;
+}
+
+.user-info {
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+}
+
+.user-name {
+    font-size: 1rem;
+    font-weight: 600;
+    color: var(--text-primary);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+.user-status {
+    font-size: 0.78rem;
+    color: var(--text-secondary);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+.chat-header-actions {
+    display: flex;
+    align-items: center;
+    gap: 4px;
+}
+
+/* Dropdown Menu */
+.dropdown-wrap {
+    position: relative;
+}
+
+.dropdown-menu {
+    position: absolute;
+    top: 48px;
+    right: 0;
+    background-color: #ffffff;
+    border-radius: 8px;
+    box-shadow: 0 4px 16px rgba(11, 20, 26, 0.18);
+    border: 1px solid var(--border-subtle);
+    min-width: 180px;
+    padding: 6px 0;
+    display: none;
+    z-index: 100;
+}
+
+.dropdown-menu.show {
+    display: block;
+}
+
+.dropdown-item {
+    display: block;
+    width: 100%;
+    padding: 10px 16px;
+    text-align: left;
+    font-size: 0.88rem;
+    background: none;
+    border: none;
+    color: var(--text-primary);
+    cursor: pointer;
+    font-family: inherit;
+    transition: background-color var(--transition-fast);
+}
+
+.dropdown-item:hover {
+    background-color: var(--bg-hover);
+}
+
+/* 2.2 Chat Messages Area */
+.chat-messages-container {
+    flex: 1;
+    overflow-y: auto;
+    overflow-x: hidden;
+    padding: 12px 6%;
+    display: flex;
+    flex-direction: column;
+    position: relative;
+}
+
+.chat-messages-container::-webkit-scrollbar {
+    width: 6px;
+}
+
+.chat-messages-container::-webkit-scrollbar-thumb {
+    background-color: rgba(0, 0, 0, 0.15);
+    border-radius: 3px;
+}
+
+.messages-loading {
+    display: flex;
+    justify-content: center;
+    padding: 12px 0;
+}
+
+.messages-flow {
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    margin-top: auto; /* Push messages down to bottom initially */
+}
+
+/* Date Divider */
+.date-divider {
+    align-self: center;
+    margin: 10px 0 8px 0;
+    background-color: #ffffff;
+    color: var(--text-secondary);
+    font-size: 0.72rem;
+    font-weight: 600;
+    padding: 4px 10px;
+    border-radius: 6px;
+    box-shadow: 0 1px 1px rgba(11, 20, 26, 0.08);
+    text-transform: uppercase;
+    letter-spacing: 0.3px;
+}
+
+/* Message Bubble */
+.message-row {
+    display: flex;
+    width: 100%;
+    margin-bottom: 3px;
+}
+
+.message-row.incoming {
+    justify-content: flex-start;
+}
+
+.message-row.outgoing {
+    justify-content: flex-end;
+}
+
+.message-bubble {
+    max-width: 60%;
+    min-width: 82px;
+    padding: 6px 9px 5px 9px;
+    border-radius: 8px;
+    box-shadow: 0 1px 0.5px rgba(11, 20, 26, 0.13);
+    font-size: 0.88rem;
+    line-height: 1.4;
+    position: relative;
+    word-wrap: break-word;
+    display: flex;
+    flex-direction: column;
+}
+
+.message-row.incoming .message-bubble {
+    background-color: var(--bubble-incoming);
+    color: var(--bubble-incoming-text);
+    border-top-left-radius: 0px;
+}
+
+.message-row.outgoing .message-bubble {
+    background-color: var(--bubble-outgoing);
+    color: var(--bubble-outgoing-text);
+    border-top-right-radius: 0px;
+}
+
+/* Message Content */
+.message-text {
+    white-space: pre-wrap;
+    word-break: break-word;
+    font-size: 0.89rem;
+    color: #111b21;
+}
+
+/* Media in bubble */
+.message-media-wrap {
+    margin: -2px -5px 4px -5px;
+    border-radius: 6px;
+    overflow: hidden;
+    max-width: 320px;
+}
+
+.message-media-wrap img {
+    width: 100%;
+    height: auto;
+    max-height: 340px;
+    object-fit: cover;
+    display: block;
+    cursor: pointer;
+    border-radius: 6px;
+    transition: opacity var(--transition-fast);
+}
+
+.message-media-wrap img:hover {
+    opacity: 0.95;
+}
+
+.message-doc-card {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    padding: 8px 10px;
+    background: rgba(0, 0, 0, 0.04);
+    border-radius: 6px;
+    text-decoration: none;
+    color: var(--text-primary);
+    border: 1px solid rgba(0, 0, 0, 0.05);
+    margin: -1px -2px 4px -2px;
+}
+
+.doc-icon-badge {
+    font-size: 1.5rem;
+}
+
+.doc-info {
+    display: flex;
+    flex-direction: column;
+    min-width: 0;
+}
+
+.doc-name {
+    font-weight: 600;
+    font-size: 0.85rem;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.doc-action {
+    font-size: 0.74rem;
+    color: var(--accent-primary);
+}
+
+/* Message Meta (Time & Status Ticks) */
+.message-meta {
+    align-self: flex-end;
+    display: flex;
+    align-items: center;
+    gap: 4px;
+    margin-left: 12px;
+    margin-top: 2px;
+    font-size: 0.7rem;
+    color: var(--text-muted);
+    line-height: 1;
+}
+
+/* Status Icons (Sent, Delivered, Read) */
+.status-tick {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    line-height: 1;
+    margin-left: 2px;
+}
+
+.status-tick svg {
+    display: inline-block;
+    vertical-align: middle;
+}
+
+.status-tick.sent svg path {
+    fill: #8696a0;
+}
+
+.status-tick.delivered svg path {
+    fill: #8696a0;
+}
+
+.status-tick.read svg path {
+    fill: #53bdeb;
+}
+
+.status-tick.failed {
+    color: var(--accent-danger);
+    font-weight: 800;
+}
+
+/* 2.3 Message Composer Area */
+.chat-composer {
+    background-color: var(--bg-composer);
+    border-top: 1px solid var(--border-subtle);
+    padding: 8px 16px;
+    position: relative;
+    z-index: 10;
+    min-height: var(--composer-min-height);
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+}
+
+.composer-form {
+    display: flex;
+    align-items: flex-end;
+    gap: 8px;
+    width: 100%;
+}
+
+.composer-btn {
+    flex-shrink: 0;
+    color: var(--text-secondary);
+}
+
+.composer-input-wrap {
+    flex: 1;
+    background-color: #ffffff;
+    border-radius: 10px;
+    padding: 8px 14px;
+    display: flex;
+    align-items: center;
+    box-shadow: 0 1px 1px rgba(11, 20, 26, 0.06);
+    border: 1px solid transparent;
+    transition: border-color var(--transition-fast);
+}
+
+.composer-input-wrap:focus-within {
+    border-color: var(--accent-primary);
+}
+
+.composer-textarea {
+    width: 100%;
+    border: none;
+    outline: none;
+    resize: none;
+    font-family: inherit;
+    font-size: 0.95rem;
+    line-height: 1.4;
+    max-height: 120px;
+    min-height: 22px;
+    color: var(--text-primary);
+    background: transparent;
+}
+
+.composer-textarea::placeholder {
+    color: var(--text-muted);
+}
+
+/* Send Button */
+.send-btn {
+    width: 42px;
+    height: 42px;
+    border-radius: 50%;
+    background-color: var(--accent-primary);
+    color: #ffffff;
+    border: none;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    cursor: pointer;
+    flex-shrink: 0;
+    transition: background-color var(--transition-fast), transform var(--transition-fast);
+    box-shadow: 0 2px 4px rgba(0, 168, 132, 0.25);
+}
+
+.send-btn:hover:not(:disabled) {
+    background-color: var(--accent-hover);
+}
+
+.send-btn:active:not(:disabled) {
+    transform: scale(0.94);
+}
+
+.send-btn:disabled {
+    background-color: #cbd5e1;
+    color: #94a3b8;
+    cursor: not-allowed;
+    box-shadow: none;
+}
+
+/* Attachment Dropup */
+.attachment-popup {
+    position: absolute;
+    bottom: 64px;
+    left: 16px;
+    background-color: #ffffff;
+    border-radius: 12px;
+    box-shadow: 0 8px 24px rgba(11, 20, 26, 0.16);
+    padding: 8px;
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    z-index: 20;
+    border: 1px solid var(--border-subtle);
+}
+
+.attachment-option {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    padding: 10px 16px;
+    background: none;
+    border: none;
+    cursor: pointer;
+    border-radius: 8px;
+    font-size: 0.9rem;
+    font-family: inherit;
+    color: var(--text-primary);
+    transition: background-color var(--transition-fast);
+}
+
+.attachment-option:hover {
+    background-color: var(--bg-hover);
+}
+
+.attachment-icon {
+    font-size: 1.2rem;
+}
+
+/* Attached File Preview Pill */
+.attached-file-preview {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    background-color: #ffffff;
+    border: 1px solid var(--border-subtle);
+    padding: 4px 12px;
+    border-radius: 16px;
+    font-size: 0.8rem;
+    margin-bottom: 8px;
+    align-self: flex-start;
+}
+
+.remove-attachment-btn {
+    background: none;
+    border: none;
+    cursor: pointer;
+    font-size: 1rem;
+    color: var(--text-muted);
+}
+
+.remove-attachment-btn:hover {
+    color: var(--accent-danger);
+}
+
+/* --------------------------------------------------------------------------
+   Toast Notifications
+   -------------------------------------------------------------------------- */
+.toast-notification {
+    position: fixed;
+    bottom: 24px;
+    right: 24px;
+    background-color: #1e293b;
+    color: #ffffff;
+    padding: 12px 20px;
+    border-radius: 8px;
+    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
+    display: none;
+    align-items: center;
+    gap: 12px;
+    font-size: 0.88rem;
+    z-index: 1000;
+    animation: toastSlideUp 0.25s ease;
+}
+
+.toast-notification.show {
+    display: flex;
+}
+
+.toast-close {
+    background: none;
+    border: none;
+    color: #94a3b8;
+    font-size: 1.2rem;
+    cursor: pointer;
+    padding: 0 4px;
+}
+
+.toast-close:hover {
+    color: #ffffff;
+}
+
+@keyframes toastSlideUp {
+    from { transform: translateY(20px); opacity: 0; }
+    to { transform: translateY(0); opacity: 1; }
+}
+
+/* --------------------------------------------------------------------------
+   Modal: New Conversation
+   -------------------------------------------------------------------------- */
+.modal-backdrop {
+    position: fixed;
+    inset: 0;
+    background-color: rgba(11, 20, 26, 0.5);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    z-index: 500;
+    padding: 16px;
+}
+
+.modal-box {
+    background-color: #ffffff;
+    border-radius: 12px;
+    width: 100%;
+    max-width: 440px;
+    padding: 24px;
+    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
+}
+
+.modal-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    margin-bottom: 20px;
+}
+
+.modal-header h3 {
+    font-size: 1.15rem;
+    font-weight: 700;
+    color: var(--text-primary);
+}
+
+.modal-close-btn {
+    background: none;
+    border: none;
+    font-size: 1.4rem;
+    color: var(--text-muted);
+    cursor: pointer;
+}
+
+.modal-field {
+    margin-bottom: 16px;
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+}
+
+.modal-field label {
+    font-size: 0.85rem;
+    font-weight: 600;
+    color: var(--text-secondary);
+}
+
+.modal-field input, .modal-field textarea {
+    padding: 10px 12px;
+    border-radius: 8px;
+    border: 1px solid var(--border-strong);
+    font-family: inherit;
+    font-size: 0.9rem;
+    outline: none;
+    transition: border-color var(--transition-fast);
+}
+
+.modal-field input:focus, .modal-field textarea:focus {
+    border-color: var(--accent-primary);
+}
+
+.modal-actions {
+    display: flex;
+    justify-content: flex-end;
+    gap: 10px;
+    margin-top: 24px;
+}
+
+.btn-secondary {
+    background-color: var(--bg-search-box);
+    border: 1px solid var(--border-subtle);
+    color: var(--text-primary);
+    padding: 8px 18px;
+    border-radius: 8px;
+    font-weight: 600;
+    cursor: pointer;
+    font-family: inherit;
+}
+
+.btn-primary {
+    background-color: var(--accent-primary);
+    border: none;
+    color: #ffffff;
+    padding: 8px 20px;
+    border-radius: 8px;
+    font-weight: 600;
+    cursor: pointer;
+    font-family: inherit;
+    transition: background-color var(--transition-fast);
+}
+
+.btn-primary:hover {
+    background-color: var(--accent-hover);
+}
+
+/* --------------------------------------------------------------------------
+   RESPONSIVE DESIGN SPECIFICATIONS
+   -------------------------------------------------------------------------- */
+
+/* Tablet: 35% Conversations / 65% Chat */
+@media (max-width: 1024px) {
+    .conversations-panel {
+        width: 35%;
+        min-width: 300px;
+    }
+    .chat-panel {
+        width: 65%;
+    }
+}
+
+/* Mobile: Single section visible at a time */
+@media (max-width: 768px) {
+    .crm-app-container {
+        width: 100vw;
+        height: 100vh;
+    }
+
+    .conversations-panel {
+        width: 100%;
+        min-width: 100%;
+        max-width: 100%;
+        border-right: none;
+    }
+
+    .chat-panel {
+        width: 100%;
+        position: absolute;
+        inset: 0;
+        z-index: 20;
+        transform: translateX(100%);
+        transition: transform var(--transition-smooth);
+    }
+
+    /* Active state on mobile: Show chat panel */
+    .crm-app-container.mobile-chat-open .chat-panel {
+        transform: translateX(0);
+    }
+
+    .crm-app-container.mobile-chat-open .conversations-panel {
+        transform: translateX(-20%);
+    }
+
+    .back-btn {
+        display: inline-flex;
+    }
+
+    .message-bubble {
+        max-width: 82%;
+    }
+}
+
+/* ==========================================================================
+   Automation & Flow Builder UI Integrations
+   ========================================================================== */
+
+.header-link-btn {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    padding: 6px 10px;
+    border-radius: 8px;
+    background: rgba(16, 185, 129, 0.12);
+    border: 1px solid rgba(16, 185, 129, 0.3);
+    color: #10b981;
+    font-size: 12px;
+    font-weight: 600;
+    text-decoration: none;
+    transition: all 0.2s ease;
+}
+
+.header-link-btn:hover {
+    background: #10b981;
+    color: #ffffff;
+    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
+}
+
+.automation-toggle-btn {
+    display: inline-flex;
+    align-items: center;
+    gap: 5px;
+    padding: 4px 8px;
+    border-radius: 12px;
+    background: rgba(16, 185, 129, 0.15);
+    border: 1px solid rgba(16, 185, 129, 0.3);
+    color: #34d399;
+    font-size: 11px;
+    font-weight: 700;
+    cursor: pointer;
+    transition: all 0.2s ease;
+}
+
+.automation-toggle-btn.disabled {
+    background: rgba(239, 68, 68, 0.12);
+    border-color: rgba(239, 68, 68, 0.3);
+    color: #f87171;
+}
+
+.automation-toggle-btn .toggle-dot {
+    width: 6px;
+    height: 6px;
+    border-radius: 50%;
+    background-color: #10b981;
+}
+
+.automation-toggle-btn.disabled .toggle-dot {
+    background-color: #ef4444;
+}
+
+/* Handover Banner Pill in Chat Header */
+.handover-pill-wrap {
+    display: flex;
+    align-items: center;
+    gap: 6px;
+    background: rgba(239, 68, 68, 0.1);
+    border: 1px solid rgba(239, 68, 68, 0.25);
+    padding: 3px 6px;
+    border-radius: 8px;
+}
+
+.handover-badge {
+    font-size: 11px;
+    font-weight: 700;
+    color: #fb7185;
+}
+
+.btn-resume-bot {
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    background: #10b981;
+    color: #ffffff;
+    border: none;
+    border-radius: 6px;
+    padding: 4px 8px;
+    font-size: 11px;
+    font-weight: 700;
+    cursor: pointer;
+    transition: background 0.15s ease;
+}
+
+.btn-resume-bot:hover {
+    background: #059669;
+}
