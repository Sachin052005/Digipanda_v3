diff --git a/templates/calls/missed_calls_list.html b/templates/calls/missed_calls_list.html
new file mode 100644
index 0000000..c0801cb
--- /dev/null
+++ b/templates/calls/missed_calls_list.html
@@ -0,0 +1,79 @@
+{% extends 'base.html' %}
+{% block title %}Missed Calls - TECHPANDA CRM{% endblock %}
+
+{% block content %}
+<div class="page-header">
+  <div class="page-title-group">
+    <h1>Missed Google Ads Calls</h1>
+    <p>Students who called the Google Ads number and haven't been called back yet</p>
+  </div>
+</div>
+
+<div class="kpi-grid">
+  <div class="kpi-card">
+    <div class="kpi-info">
+      <h4>Leads to call back</h4>
+      <div class="kpi-value" style="color: var(--danger);">{{ total }}</div>
+    </div>
+    <div class="kpi-icon-wrap rose"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon></div>
+  </div>
+</div>
+
+<div class="crm-card">
+  <div class="crm-card-body" style="padding: 12px 24px;">
+    {% if page_obj.object_list %}
+    <div class="table-responsive">
+      <table class="crm-table" style="width: 100%;">
+        <thead>
+          <tr>
+            <th>Lead</th>
+            <th>Phone</th>
+            <th>Last missed call</th>
+            <th>Missed</th>
+            <th>Telecaller</th>
+            <th>Branch</th>
+            <th>Status</th>
+            <th></th>
+          </tr>
+        </thead>
+        <tbody>
+          {% for row in page_obj.object_list %}
+          <tr>
+            <td><a href="{% url lead_detail_url_name row.lead.pk %}" style="font-weight: 600;">{{ row.lead.name }}</a></td>
+            <td>
+              <a href="tel:{{ row.lead.phone }}" style="font-family: monospace;">{{ row.lead.phone }}</a>
+            </td>
+            <td>{{ row.last_missed.started_at|date:"d M Y, h:i A" }}</td>
+            <td>{{ row.missed_count }}</td>
+            <td>{% if row.lead.assigned_telecaller %}{{ row.lead.assigned_telecaller.get_full_name|default:row.lead.assigned_telecaller.username }}{% else %}Unassigned{% endif %}</td>
+            <td>{{ row.lead.branch.name|default:"—" }}</td>
+            <td>{{ row.lead.status }}</td>
+            <td>
+              <form method="post" action="{% url 'mark_lead_called_back' row.lead.pk %}" style="margin: 0;">
+                {% csrf_token %}
+                <input type="hidden" name="next" value="{{ request.get_full_path }}">
+                <button type="submit" class="btn btn-sm btn-secondary">✅ Called back</button>
+              </form>
+            </td>
+          </tr>
+          {% endfor %}
+        </tbody>
+      </table>
+    </div>
+
+    {% if page_obj.has_other_pages %}
+    <div style="display: flex; gap: 8px; justify-content: center; padding: 12px 0;">
+      {% if page_obj.has_previous %}<a class="btn btn-sm btn-secondary" href="?page={{ page_obj.previous_page_number }}">← Previous</a>{% endif %}
+      <span style="align-self: center;">Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}</span>
+      {% if page_obj.has_next %}<a class="btn btn-sm btn-secondary" href="?page={{ page_obj.next_page_number }}">Next →</a>{% endif %}
+    </div>
+    {% endif %}
+    {% else %}
+    <div style="text-align: center; color: var(--text-muted); padding: 32px 16px;">
+      <p style="margin: 0; font-size: 0.95rem;">No missed calls waiting. 🎉</p>
+      <p style="margin: 4px 0 0; font-size: 0.8rem;">Missed calls on the Google Ads number appear here, and in Follow-ups due 15 minutes after the call.</p>
+    </div>
+    {% endif %}
+  </div>
+</div>
+{% endblock %}
