+                    { id: "trigger_1", type: "trigger", title: "Trigger", x: 200, y: 150, trigger_type: trigger, data: { trigger_type: trigger } },
+                    { id: "msg_1", type: "message", title: "Welcome Message", x: 200, y: 320, data: { text: "Hello! Welcome to our WhatsApp service." } },
+                    { id: "end_1", type: "end", title: "End", x: 200, y: 490, data: { text: "Thank you for reaching out!" } }
+                ],
+                connections: [
+                    { source: "trigger_1", source_output: "default", target: "msg_1", target_input: "input" },
+                    { source: "msg_1", source_output: "default", target: "end_1", target_input: "input" }
+                ]
+            };
+
+            try {
+                const res = await fetch('/api/flows/', {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({
+                        name: name,
+                        slug: name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
+                        version: 1,
+                        trigger_type: trigger,
+                        trigger_keywords: keywords,
+                        flow_data: blankFlowData
+                    })
+                });
+                if (!res.ok) throw new Error('Failed to create automation');
+                const created = await res.json();
+                createModal.style.display = 'none';
+                showToast('Automation created successfully!');
+                const targetId = created.flow ? created.flow.id : created.id;
+                window.location.href = `/automation/?id=${targetId}`;
+            } catch (err) {
+                showToast('Could not create automation');
+            }
+        };
+
+        function escapeHtml(str) {
+            if (!str) return '';
+            return str.replace(/[&<>'"]/g, tag => ({
+                '&': '&amp;',
+                '<': '&lt;',
+                '>': '&gt;',
+                "'": '&#39;',
+                '"': '&quot;'
+            }[tag] || tag));
+        }
+
+        function formatDate(dateStr) {
+            if (!dateStr) return '';
+            const d = new Date(dateStr);
+            return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
+        }
+
+        // Init
+        fetchAutomations();
+    </script>
+</body>
+</html>
