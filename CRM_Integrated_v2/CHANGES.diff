+                            <div class="flow-card-badges">
+                                <span class="badge-version">v${f.version}</span>
+                                <span class="badge-status ${isPublished ? 'badge-published' : 'badge-draft'}">
+                                    ${isPublished ? 'Published' : 'Draft'}
+                                </span>
+                            </div>
+                        </div>
+
+                        <div class="flow-card-stats">
+                            <div class="stat-item">
+                                <span class="stat-val">${(f.active_sessions_count !== undefined) ? f.active_sessions_count : 0}</span>
+                                <span class="stat-label">Active</span>
+                            </div>
+                            <div class="stat-item" style="border-left: 1px solid var(--border-subtle); padding-left: 20px;">
+                                <span class="stat-val">${(f.completed_sessions_count !== undefined) ? f.completed_sessions_count : 0}</span>
+                                <span class="stat-label">Completed</span>
+                            </div>
+                        </div>
+
+                        <div class="flow-card-footer">
+                            <span class="flow-card-meta">${isPublished && f.published_at ? 'Published ' + formatDate(f.published_at) : 'Draft'}</span>
+                            <div class="flow-card-btns">
+                                <a href="/automation/?id=${f.id}" class="btn-card-edit">
+                                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
+                                        <path d="M12 20h9"></path>
+                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
+                                    </svg>
+                                    <span>Edit</span>
+                                </a>
+                                <button class="btn-card-more" onclick="toggleCardMenu(${f.id}, event)" title="More options">
+                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
+                                        <circle cx="12" cy="5" r="2"></circle>
+                                        <circle cx="12" cy="12" r="2"></circle>
+                                        <circle cx="12" cy="19" r="2"></circle>
+                                    </svg>
+                                </button>
+                                <div class="card-menu-dropdown" id="cardMenu_${f.id}">
+                                    <button class="card-menu-item" onclick="createDraftFromCard(${f.id})">
+                                        <span>Create Draft</span>
+                                    </button>
+                                    <button class="card-menu-item danger" onclick="confirmDeleteFlow(${f.id}, '${escapeHtml(f.name)}')">
+                                        <span>Delete Flow</span>
+                                    </button>
+                                </div>
+                            </div>
+                        </div>
