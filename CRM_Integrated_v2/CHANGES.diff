-  if (modal) {
-    modal.style.display = 'flex';
-  }
-}
-
-function closeAddDriveModal() {
-  var modal = document.getElementById('addDriveModal');
-  if (modal) {
-    modal.style.display = 'none';
-  }
-}
-
-window.addEventListener('click', function(event) {
-  var modal = document.getElementById('addDriveModal');
-  if (event.target === modal) {
-    closeAddDriveModal();
-  }
-});
-
-// ==========================================
-// 15-SECOND AUTO SYNC & INCREMENTAL POLLING
-// ==========================================
-const AUTO_SYNC_INTERVAL = 15000; // 15 seconds
-let autoSyncTimer = null;
-let activeConnectionIds = {{ active_connection_ids|default:"[]"|safe }};
-let isPollInProgress = false;
-
-function startDriveAutoSync() {
-  if (autoSyncTimer) {
-    clearTimeout(autoSyncTimer);
-    autoSyncTimer = null;
-  }
-  if (activeConnectionIds && activeConnectionIds.length > 0) {
-    autoSyncTimer = setTimeout(syncAllConnections, AUTO_SYNC_INTERVAL);
-  }
-}
-
-function syncAllConnections() {
-  if (isPollInProgress || !activeConnectionIds || activeConnectionIds.length === 0) return;
-
-  isPollInProgress = true;
-  fetch('/drive/api/sync-all/', {
-    headers: {
-      'X-Requested-With': 'XMLHttpRequest'
-    }
-  })
-    .then(res => {
-      if (!res.ok) throw new Error('HTTP ' + res.status);
-      return res.json();
-    })
-    .then(data => {
-      if (data.success) {
-        // Update stats
-        const recEl = document.getElementById('statRecordingsFound');
-        if (recEl && data.total_archived !== undefined) recEl.textContent = data.total_archived;
-
-        const countHeader = document.getElementById('tableRecordingsCount');
-        if (countHeader && data.total_archived !== undefined) countHeader.textContent = `CALL RECORDINGS (${data.total_archived})`;
-
-        const matchedEl = document.getElementById('statMatchedLeads');
-        if (matchedEl && data.matched_count !== undefined) matchedEl.textContent = data.matched_count;
-
-        const unmatchedEl = document.getElementById('statUnmatchedRecordings');
-        if (unmatchedEl && data.unmatched_count !== undefined) unmatchedEl.textContent = data.unmatched_count;
-
-        const lastSyncEl = document.getElementById('statLastSync');
-        if (lastSyncEl) {
-          lastSyncEl.textContent = 'Just now';
-        }
-
-        // Dynamically add new recordings if available
-        if (data.connections) {
-          data.connections.forEach(conn => {
-            if (conn.new_files > 0) {
-              fetch(`/drive/api/sync/${conn.connection_id}/`, {
-                headers: { 'X-Requested-With': 'XMLHttpRequest' }
-              })
-                .then(r => r.json())
-                .then(cData => {
-                  if (cData.recordings && cData.recordings.length > 0) {
-                    updateRecordingsTable(cData.recordings);
-                  }
-                }).catch(() => {});
-            }
-          });
-        }
-      }
-    })
-    .catch(err => {
-      console.warn("Drive auto-sync polling error:", err);
-    })
-    .finally(() => {
-      isPollInProgress = false;
-      if (activeConnectionIds && activeConnectionIds.length > 0) {
-        autoSyncTimer = setTimeout(syncAllConnections, AUTO_SYNC_INTERVAL);
-      }
-    });
-}
-
-function updateRecordingsTable(recordings) {
-  const tbody = document.getElementById('callRecordingsTableBody');
-  if (!tbody) return;
-
-  recordings.forEach(rec => {
-    const existingRow = document.getElementById(`recording-row-${rec.id}`);
-    if (!existingRow) {
-      const emptyRow = tbody.querySelector('.empty-recordings-row');
-      if (emptyRow) emptyRow.remove();
-
-      const tr = document.createElement('tr');
-      tr.id = `recording-row-${rec.id}`;
-
-      const leadLink = rec.lead_name
-        ? `<span style="font-weight: 600; color: var(--color-primary);">${escapeHtml(rec.lead_name)}</span>`
-        : '<span style="color: var(--text-muted); font-size: 0.85rem;">—</span>';
-
-      const badge = rec.match_status === 'MATCHED'
-        ? '<span class="badge" style="background: #dcfce7; color: #15803d; font-weight: 700;">🟢 Matched</span>'
-        : '<span class="badge" style="background: #fef3c7; color: #b45309; font-weight: 700;">⚠ Unmatched</span>';
-
-      tr.innerHTML = `
-        <td><div style="font-weight: 600; color: var(--text-main); word-break: break-all;">🎙 ${escapeHtml(rec.file_name)}</div></td>
-        <td><span style="font-family: monospace; font-weight: 600; color: var(--text-main);">${escapeHtml(rec.mobile_number || 'None')}</span></td>
-        <td>${leadLink}</td>
-        <td><span style="font-size: 0.85rem; color: var(--text-muted);">📁 Current Folder</span></td>
-        <td><span style="font-size: 0.85rem; font-weight: 600; color: var(--text-main);">${escapeHtml(rec.duration || '04:32')}</span></td>
-        <td>${badge}</td>
-        <td>
-          <div style="display: flex; align-items: center; gap: 6px;">
-            <audio id="audio-rec-${rec.id}" controls preload="none" style="height: 34px; max-width: 200px;">
-              <source src="/drive/stream/${rec.id}/" type="audio/mpeg">
-            </audio>
-            <button type="button" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('audio-rec-${rec.id}').play()" style="padding: 4px 8px; font-size: 0.78rem; font-weight: 600; white-space: nowrap;">▶ Play</button>
-          </div>
-        </td>
-        <td>
-          ${rec.drive_url ? `<a href="${rec.drive_url}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary" style="display: inline-flex; align-items: center; gap: 4px; text-decoration: none; font-weight: 600; white-space: nowrap;">Open in Drive</a>` : ''}
-        </td>
-      `;
-      tbody.prepend(tr);
-    }
-  });
-}
-
-function escapeHtml(str) {
-  if (!str) return '';
-  return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
-}
-
-document.addEventListener('DOMContentLoaded', function() {
-  startDriveAutoSync();
-});
-</script>
-{% endblock %}
