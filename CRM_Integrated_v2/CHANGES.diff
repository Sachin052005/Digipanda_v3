+@login_required
+def missed_calls_list(request):
+    """Leads with a missed / rejected Google Ads call still waiting for a call back (role-scoped)."""
+    from .sync_services import leads_with_pending_callback
+    from .models import CallEvent
+
+    leads = leads_with_pending_callback(request.user).select_related('assigned_telecaller', 'branch')
+    rows = []
+    for lead in leads:
+        pending = list(CallEvent.objects.filter(lead=lead, needs_callback=True).order_by('-started_at'))
+        rows.append({
+            'lead': lead,
+            'last_missed': pending[0] if pending else None,
+            'missed_count': len(pending),
+        })
+    rows.sort(key=lambda r: r['last_missed'].started_at if r['last_missed'] else timezone.now(), reverse=True)
