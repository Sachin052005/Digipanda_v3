+    @classmethod
+    def interpolate(cls, template: str, data: Dict[str, Any]) -> str:
+        """Replaces {{key}} with collected session variables."""
+        if not template:
+            return ''
+        def replace(match):
+            key = match.group(1).strip()
+            return str(data.get(key, f"[{key}]"))
+        return re.sub(r'\{\{\s*([a-zA-Z0-9_]+)\s*\}\}', replace, template)
