+                                li.appendChild(span);
+
+                                const match = err.match(/node\s+["']?([a-zA-Z0-9_-]+)["']?/i) || err.match(/#([a-zA-Z0-9_-]+)/);
+                                if (match && match[1]) {
+                                    const nodeId = match[1];
+                                    const fixBtn = document.createElement('button');
