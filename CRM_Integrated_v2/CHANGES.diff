+
+                                elements.validationErrorList.appendChild(li);
+                            });
+                            elements.validationModalBackdrop.style.display = 'flex';
+                            showToast('Validation failed: check errors', true);
+                            return;
+                        }
+                        throw new Error(data.error || 'Publish failed');
