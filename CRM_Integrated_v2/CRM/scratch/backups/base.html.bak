{% load static %}
{% load calls_tags %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" type="image/png" href="{% static 'images/favicon.png' %}">
  <link rel="shortcut icon" href="{% static 'images/favicon.ico' %}">
  <title>{% block title %}DigipandaCRM{% endblock %}</title>
  <!-- Google Fonts: Plus Jakarta Sans (Brand/Headings) + Inter (Interface) + JetBrains Mono (Data/Code) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <!-- Early Theme Attribution (Zero-FOUC) -->
  <script src="{% static 'js/theme-manager.js' %}?v=20261022_dropdown_fix"></script>
  <link rel="stylesheet" href="{% static 'css/crm.css' %}?v=20261024_zoom100_v3">
  <link rel="stylesheet" href="{% static 'css/design-system.css' %}?v=20261024_zoom100_v3">
  <link rel="stylesheet" href="{% static 'css/lead-details-modern.css' %}?v=20261015_aura">
  <link rel="stylesheet" href="{% static 'css/modern-saas-core.css' %}?v=20261025_saas">
  <!-- Chart.js and Custom Enterprise Theme Engine -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
  <script src="{% static 'js/chart-theme.js' %}?v=20261016_glossy" defer></script>
  {% block extra_head %}{% endblock %}
</head>
<body>
  <div class="app-container">
    {% if user.is_authenticated %}
    <!-- Reusable Collapsible Sidebar -->
    <aside class="app-sidebar" aria-label="Main Navigation">
      <div class="sidebar-header">
        <a href="{% url 'login_redirect' %}" class="brand-logo" style="display: flex; align-items: center; gap: 8px; text-decoration: none;">
          <img src="{% static 'images/digipanda_symbol.png' %}" alt="Digipanda" width="28" height="31" style="object-fit: contain; flex-shrink: 0;" class="brand-symbol">
          <div class="brand-full-logo-wrap" style="display: flex; align-items: center; gap: 6px;">
            <img src="{% static 'images/digipanda_logo.svg' %}" alt="digipanda" class="brand-logo-light" style="height: 26px; width: auto; object-fit: contain;">
            <img src="{% static 'images/digipanda_logo_dark.svg' %}" alt="digipanda" class="brand-logo-dark" style="height: 26px; width: auto; object-fit: contain; display: none;">
            <span class="part-crm" style="color: #2bb34b; font-weight: 800; font-size: 0.76rem; letter-spacing: 0.04em; background: rgba(43, 179, 75, 0.12); border: 1px solid rgba(43, 179, 75, 0.3); padding: 1px 5px; border-radius: 5px;">CRM</span>
          </div>
        </a>
      </div>

      <nav class="sidebar-nav">
        {% if is_admin %}
        <!-- ADMIN NAVIGATION -->
        <div class="nav-section-title">Core Operations</div>
        <a href="{% url 'admin_dashboard' %}" class="nav-item {% if request.resolver_match.url_name == 'admin_dashboard' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span class="nav-text">Dashboard</span>
        </a>
        <a href="{% url 'leads_kanban' %}" class="nav-item {% if request.resolver_match.url_name == 'leads_kanban' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="18"></rect><rect x="14" y="3" width="7" height="10"></rect></svg>
          <span class="nav-text">Pipeline (Kanban)</span>
        </a>
        <a href="{% url 'admin_reports' %}" class="nav-item {% if request.resolver_match.url_name == 'admin_reports' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          <span class="nav-text">Reports & Analytics</span>
        </a>

        <!-- GROUP: Team & Staff -->
        <div class="nav-group" id="nav-group-admin-team">
          <div class="nav-group-header" data-target="admin-team-nav">
            <div class="nav-group-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              <span>Team & Staff</span>
            </div>
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
          <div class="nav-group-children" id="admin-team-nav">
            <!-- <a href="{% url 'admin_user_create' %}" class="nav-item {% if request.resolver_match.url_name == 'admin_user_create' %}active{% endif %}" style="color: var(--primary); font-weight: 600;">
              <span class="nav-text">+ Add Team Member</span>
            </a> -->
            <a href="{% url 'admin_managers_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_managers_list admin_manager_create admin_manager_detail admin_manager_edit admin_manager_delete' %}active{% endif %}">
              <span class="nav-text">Sales Heads</span>
            </a>
            <a href="{% url 'admin_branch_heads_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_branch_heads_list admin_branch_head_create admin_branch_head_detail admin_branch_head_edit admin_branch_head_delete' %}active{% endif %}">
              <span class="nav-text">Branch Heads</span>
            </a>
            <a href="{% url 'admin_branch_admins_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_branch_admins_list admin_branch_admin_create admin_branch_admin_detail admin_branch_admin_edit' %}active{% endif %}">
              <span class="nav-text">Branch Admins</span>
            </a>
            <a href="{% url 'admin_counselors_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_counselors_list admin_counselor_create admin_counselor_detail admin_counselor_change_password' %}active{% endif %}">
              <span class="nav-text">Counselors</span>
            </a>
            <a href="{% url 'admin_telecallers_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_telecallers_list admin_telecaller_create admin_telecaller_detail admin_telecaller_edit admin_telecaller_assign admin_telecaller_change_password' %}active{% endif %}">
              <span class="nav-text">Telecallers</span>
            </a>
            <a href="{% url 'admin_receptionists_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_receptionists_list admin_receptionist_create admin_receptionist_change_password' %}active{% endif %}">
              <span class="nav-text">Receptionists</span>
            </a>
            <a href="{% url 'admin_accountants_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_accountants_list' %}active{% endif %}">
              <span class="nav-text">Accountants</span>
            </a>
          </div>
        </div>

        <!-- GROUP: Lead Operations -->
        <a href="{% url 'admin_leads_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_leads_list admin_lead_create admin_lead_detail admin_lead_edit admin_lead_delete admin_leads_import admin_lead_update_status admin_lead_duplicate_info admin_retry_pending_assignments admin_interested_leads admin_demo_scheduled_leads admin_converted_leads admin_lost_leads admin_later_leads admin_discussion_leads admin_new_leads admin_lead_queues admin_walkin_desk admin_duplicate_leads admin_duplicate_leads_keep_single admin_enrolled_students' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
          <span class="nav-text">All Leads</span>
        </a>

        <!-- GROUP: Calls & Omnichannel -->
        <div class="nav-group" id="nav-group-admin-comms">
          <div class="nav-group-header" data-target="admin-comms-nav">
            <div class="nav-group-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span>Calls & WhatsApp</span>
            </div>
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
          <div class="nav-group-children" id="admin-comms-nav">
            <a href="{% url 'admin_followups_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_followups_list admin_followup_create admin_followup_edit admin_followup_reschedule' %}active{% endif %}">
              <span class="nav-text">Follow-ups</span>
            </a>
            <a href="{% url 'missed_calls_list' %}" class="nav-item {% if request.resolver_match.url_name == 'missed_calls_list' %}active{% endif %}">
              <span class="nav-text">Missed Calls{% missed_callbacks_count as missed_cb %}{% if missed_cb %} <span class="badge" style="background:#dc2626;color:#fff;font-size:0.7rem;padding:1px 6px;border-radius:10px;">{{ missed_cb }}</span>{% endif %}</span>
            </a>
            <a href="{% url 'inbox' %}" class="nav-item {% if request.resolver_match.url_name == 'inbox' %}active{% endif %}">
              <span class="nav-text">WhatsApp Chats</span>
            </a>
            <a href="{% url 'whatsapp_campaigns_list' %}" class="nav-item {% if request.resolver_match.url_name in 'whatsapp_campaigns_list whatsapp_campaign_create whatsapp_campaign_detail' %}active{% endif %}">
              <span class="nav-text">WhatsApp Campaigns</span>
            </a>
            <a href="{% url 'automation-list' %}" class="nav-item {% if request.resolver_match.url_name in 'automation-list flow-builder flow-builder-detail' %}active{% endif %}">
              <span class="nav-text">WhatsApp Automations</span>
            </a>
            <a href="{% url 'fb_leads:facebook_leads' %}" class="nav-item {% if request.resolver_match.namespace == 'fb_leads' and request.resolver_match.url_name == 'facebook_leads' %}active{% endif %}">
              <span class="nav-text">Facebook Leads</span>
            </a>
            <a href="{% url 'telecaller_rnr_report' %}" class="nav-item {% if request.resolver_match.url_name == 'telecaller_rnr_report' %}active{% endif %}">
              <span class="nav-text">Telecaller RNR Report</span>
            </a>
          </div>
        </div>

        <!-- GROUP: Finance & Accounts -->
        <div class="nav-group" id="nav-group-admin-finance">
          <div class="nav-group-header" data-target="admin-finance-nav">
            <div class="nav-group-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
              <span>Finance & Accounts</span>
            </div>
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
          <div class="nav-group-children" id="admin-finance-nav">
            <a href="{% url 'accountant_dashboard' %}" class="nav-item {% if request.resolver_match.url_name == 'accountant_dashboard' %}active{% endif %}">
              <span class="nav-text">Financial Dashboard</span>
            </a>
            <a href="{% url 'accountant_payment_verification' %}" class="nav-item {% if request.resolver_match.url_name == 'accountant_payment_verification' %}active{% endif %}">
              <span class="nav-text">Payment Verification</span>
            </a>
            <a href="{% url 'admin_enrolled_students' %}" class="nav-item {% if request.resolver_match.url_name == 'admin_enrolled_students' %}active{% endif %}">
              <span class="nav-text">Student Enrollments</span>
            </a>
            <a href="{% url 'accountant_monthly_report_excel' %}" class="nav-item">
              <span class="nav-text">Financial Report (Excel)</span>
            </a>
          </div>
        </div>

        <!-- GROUP: Master Setup & System -->
        <div class="nav-group" id="nav-group-admin-setup">
          <div class="nav-group-header" data-target="admin-setup-nav">
            <div class="nav-group-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
              <span>Master Setup</span>
            </div>
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
          <div class="nav-group-children" id="admin-setup-nav">
            <a href="{% url 'admin_branches_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_branches_list admin_branch_create admin_branch_edit admin_branch_delete' %}active{% endif %}">
              <span class="nav-text">Branches</span>
            </a>
            <a href="{% url 'admin_channels_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_channels_list admin_channel_create admin_channel_edit admin_channel_delete' %}active{% endif %}">
              <span class="nav-text">Channels</span>
            </a>
            <a href="{% url 'admin_products_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_products_list admin_product_edit' %}active{% endif %}">
              <span class="nav-text">Courses & Programs</span>
            </a>
            <a href="{% url 'admin_pipeline_statuses' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_pipeline_statuses admin_pipeline_status_edit' %}active{% endif %}">
              <span class="nav-text">Pipeline Statuses</span>
            </a>
            <a href="{% url 'admin_offline_leads_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_offline_leads admin_offline_leads_list admin_google_sheet_connect admin_google_sheet_history admin_offline_leads_upload admin_google_sheet_edit' %}active{% endif %}">
              <span class="nav-text">Offline / Google Sheets</span>
            </a>
            <a href="{% url 'fb_leads:fb_accounts' %}" class="nav-item {% if request.resolver_match.url_name == 'fb_accounts' %}active{% endif %}">
              <span class="nav-text">Facebook Connections</span>
            </a>
            <a href="{% url 'admin_walkin_forms_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_walkin_forms_list admin_walkin_form_create admin_walkin_form_edit walkin_form_qr_standee' %}active{% endif %}">
              <span class="nav-text">Walk-in Enquiry Form</span>
            </a>
            <a href="{% url 'admin_lead_setup' %}" class="nav-item {% if request.resolver_match.url_name == 'admin_lead_setup' %}active{% endif %}">
              <span class="nav-text">Lead Allocation Setup</span>
            </a>
            <a href="{% url 'admin_activities_list' %}" class="nav-item {% if request.resolver_match.url_name in 'admin_activities_list admin_activity_detail' %}active{% endif %}">
              <span class="nav-text">Audit Activities</span>
            </a>
          </div>
        </div>

        {% elif is_manager %}
        <!-- MANAGER NAVIGATION -->
        <div class="nav-section-title">Sales Head Portal</div>
        <a href="{% url 'manager_dashboard' %}" class="nav-item {% if request.resolver_match.url_name == 'manager_dashboard' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span class="nav-text">Dashboard</span>
        </a>
        <a href="{% url 'manager_telecallers_list' %}" class="nav-item {% if request.resolver_match.url_name in 'manager_telecallers_list manager_telecaller_detail manager_telecaller_create' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
          <span class="nav-text">My Telecallers</span>
        </a>
        <a href="{% url 'sales_head_branch_heads_list' %}" class="nav-item {% if request.resolver_match.url_name in 'sales_head_branch_heads_list sales_head_branch_head_detail' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
          <span class="nav-text">Branch Heads</span>
        </a>
        <a href="{% url 'manager_leads_list' %}" class="nav-item {% if request.resolver_match.url_name in 'manager_leads_list manager_lead_create manager_lead_detail manager_lead_edit manager_lead_import' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
          <span class="nav-text">Leads</span>
        </a>
        <a href="{% url 'leads_kanban' %}" class="nav-item {% if request.resolver_match.url_name == 'leads_kanban' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="18"></rect><rect x="14" y="3" width="7" height="10"></rect></svg>
          <span class="nav-text">Pipeline (Kanban)</span>
        </a>
        <a href="{% url 'manager_followups_list' %}" class="nav-item {% if request.resolver_match.url_name in 'manager_followups_list' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <span class="nav-text">Follow-ups</span>
        </a>
        <a href="{% url 'missed_calls_list' %}" class="nav-item {% if request.resolver_match.url_name == 'missed_calls_list' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path><line x1="23" y1="1" x2="17" y2="7"></line><line x1="17" y1="1" x2="23" y2="7"></line></svg>
          <span class="nav-text">Missed Calls{% missed_callbacks_count as missed_cb %}{% if missed_cb %} <span class="badge" style="background:#dc2626;color:#fff;font-size:0.7rem;padding:1px 6px;border-radius:10px;">{{ missed_cb }}</span>{% endif %}</span>
        </a>

        <a href="{% url 'inbox' %}" class="nav-item {% if request.resolver_match.url_name == 'inbox' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          <span class="nav-text">WhatsApp Chats</span>
        </a>
        <a href="{% url 'whatsapp_campaigns_list' %}" class="nav-item {% if request.resolver_match.url_name in 'whatsapp_campaigns_list whatsapp_campaign_create whatsapp_campaign_detail' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"></path><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          <span class="nav-text">WhatsApp Campaigns</span>
        </a>
        <a href="{% url 'automation-list' %}" class="nav-item {% if request.resolver_match.url_name in 'automation-list flow-builder flow-builder-detail' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          <span class="nav-text">WhatsApp Automations</span>
        </a>
        <a href="{% url 'fb_leads:facebook_leads' %}" class="nav-item {% if request.resolver_match.namespace == 'fb_leads' %}active{% endif %}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          <span class="nav-text">Facebook Leads</span>
        </a>
        <a href="{% url 'manager_reports' %}" class="nav-item {% if request.resolver_match.url_name == 'manager_reports' %}active{% endif %}">
