  <!-- ==========================================================================
       Interactive Kinetic 3D Engine & Cockpit Scripts
       ========================================================================== -->
  <script>
    /* 1. Real-Time Hardware-Accelerated Three.js 3D WebGL Cyber Core & Constellation */
    (function init3DHeroScene() {
      const container = document.getElementById('hero3dContainer');
      if (!container) return;

      if (typeof THREE === 'undefined') {
        console.warn('Three.js CDN not available, skipping WebGL core');
        return;
      }

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(55, container.clientWidth / container.clientHeight, 0.1, 1000);
      camera.position.z = 32;

      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'high-performance' });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      const coreGroup = new THREE.Group();
      scene.add(coreGroup);

      // Central Icosahedron Wireframe
      const icoGeo = new THREE.IcosahedronGeometry(8.5, 1);
      const icoMat = new THREE.MeshBasicMaterial({
        color: 0x38bdf8,
        wireframe: true,
        transparent: true,
        opacity: 0.6
      });
      const icoMesh = new THREE.Mesh(icoGeo, icoMat);
      coreGroup.add(icoMesh);

      // Inner Glowing Nucleus Sphere
      const innerGeo = new THREE.SphereGeometry(4.2, 16, 16);
      const innerMat = new THREE.MeshBasicMaterial({
        color: 0x10b981,
        wireframe: true,
        transparent: true,
        opacity: 0.35
      });
      const innerMesh = new THREE.Mesh(innerGeo, innerMat);
      coreGroup.add(innerMesh);

      // Outer Concentric Orbital Torus Rings
      const ring1Geo = new THREE.TorusGeometry(12.5, 0.08, 16, 100);
      const ring1Mat = new THREE.MeshBasicMaterial({ color: 0x0ea5e9, transparent: true, opacity: 0.75 });
      const ring1 = new THREE.Mesh(ring1Geo, ring1Mat);
      ring1.rotation.x = Math.PI / 3;
      coreGroup.add(ring1);

      const ring2Geo = new THREE.TorusGeometry(15.2, 0.08, 16, 100);
      const ring2Mat = new THREE.MeshBasicMaterial({ color: 0x34d399, transparent: true, opacity: 0.65 });
      const ring2 = new THREE.Mesh(ring2Geo, ring2Mat);
      ring2.rotation.y = Math.PI / 4;
      ring2.rotation.x = -Math.PI / 6;
      coreGroup.add(ring2);

      // 1,200 Star Particles
      const starCount = 1200;
      const starGeo = new THREE.BufferGeometry();
      const starPositions = new Float32Array(starCount * 3);
      const starColors = new Float32Array(starCount * 3);

      const colors = [
        new THREE.Color(0x38bdf8),
        new THREE.Color(0x34d399),
        new THREE.Color(0x818cf8),
        new THREE.Color(0xffffff)
      ];

      for (let i = 0; i < starCount; i++) {
        starPositions[i * 3] = (Math.random() - 0.5) * 140;
        starPositions[i * 3 + 1] = (Math.random() - 0.5) * 90;
        starPositions[i * 3 + 2] = (Math.random() - 0.5) * 90;

        const c = colors[Math.floor(Math.random() * colors.length)];
        starColors[i * 3] = c.r;
        starColors[i * 3 + 1] = c.g;
        starColors[i * 3 + 2] = c.b;
      }
      starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
      starGeo.setAttribute('color', new THREE.BufferAttribute(starColors, 3));

      const starMat = new THREE.PointsMaterial({
        size: 0.8,
        vertexColors: true,
        transparent: true,
        opacity: 0.85
      });
      const starField = new THREE.Points(starGeo, starMat);
      scene.add(starField);

      // Interactive Cursor Spotlight Tracking
      const spotlight = document.getElementById('cursorSpotlight');
      let mouseX = 0, mouseY = 0;
      let targetRotX = 0, targetRotY = 0;

      window.addEventListener('mousemove', (e) => {
        if (spotlight) {
          spotlight.style.transform = `translate(${e.clientX}px, ${e.clientY}px) translate(-50%, -50%)`;
        }
        const halfW = window.innerWidth / 2;
        const halfH = window.innerHeight / 2;
        mouseX = (e.clientX - halfW) / halfW;
        mouseY = (e.clientY - halfH) / halfH;

        targetRotY = mouseX * 0.45;
        targetRotX = mouseY * 0.35;
      });

      // Responsive Resize
      window.addEventListener('resize', () => {
        if (!container) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      });

      // Render Loop
      function renderLoop() {
        requestAnimationFrame(renderLoop);

        icoMesh.rotation.x += 0.0035;
        icoMesh.rotation.y += 0.0055;

        innerMesh.rotation.x -= 0.004;
        innerMesh.rotation.y -= 0.006;

        ring1.rotation.z += 0.008;
        ring2.rotation.z -= 0.007;

        starField.rotation.y += 0.0003;
        starField.rotation.x += 0.0001;

        // Smooth Elastic Spring Parallax to Cursor
        coreGroup.rotation.y += (targetRotY - coreGroup.rotation.y) * 0.05;
        coreGroup.rotation.x += (targetRotX - coreGroup.rotation.x) * 0.05;

        camera.position.x += (mouseX * 3.0 - camera.position.x) * 0.04;
        camera.position.y += (-mouseY * 2.5 - camera.position.y) * 0.04;
        camera.lookAt(0, 0, 0);

        renderer.render(scene, camera);
      }
      renderLoop();
    })();

    /* 2. Interactive Product Showcase Tab Switching */
    function switchShowcaseTab(tabKey, btn) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.cockpit-view').forEach(v => v.classList.remove('active'));
      btn.classList.add('active');
      const targetView = document.getElementById('view-' + tabKey);
      if (targetView) targetView.classList.add('active');
    }

    /* 3. Interactive WhatsApp Simulator Logic */
    function triggerSimChat(action) {
      const body = document.getElementById('simPhoneChatBody');
      if (!body) return;

      let userMsg = '';
      let botReply = '';

      if (action === 'fees') {
        userMsg = 'Check Course Fees & Discounts';
        botReply = '🎓 Our Python Fullstack & AI diploma is ₹38,000 (Installment plan available: ₹12,000/mo). Use code PANDA2026 for a flat 15% early-bird waiver!';
      } else if (action === 'brochure') {
        userMsg = 'Download 2026 Syllabus (PDF)';
        botReply = '📄 [2026_Digipanda_Curriculum.pdf] (4.8 MB) — Verified industry syllabus with 12 live capstone projects has been dispatched to your WhatsApp!';
      } else if (action === 'counselor') {
        userMsg = 'Book 1-on-1 Counselor Call';
        botReply = '📞 Great! Counselor Anjali has been alerted. She will call you within 15 minutes to discuss batch schedules and scholarship criteria.';
      }

      // Append user bubble
      const uEl = document.createElement('div');
      uEl.className = 'phone-bubble user';
      uEl.textContent = userMsg;
      body.appendChild(uEl);
      body.scrollTop = body.scrollHeight;

      // Show animated typing indicator
      const typingEl = document.createElement('div');
      typingEl.className = 'phone-bubble bot';
      typingEl.id = 'simTypingBubble';
      typingEl.style.cssText = 'display: inline-flex; align-items: center; gap: 5px; padding: 10px 14px; width: fit-content;';
      typingEl.innerHTML = '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>';
      body.appendChild(typingEl);
      body.scrollTop = body.scrollHeight;

      // Simulated Bot typing delay
      setTimeout(() => {
        if (typingEl && typingEl.parentNode) {
          typingEl.parentNode.removeChild(typingEl);
        }
        const bEl = document.createElement('div');
        bEl.className = 'phone-bubble bot';
        bEl.textContent = botReply;
        body.appendChild(bEl);
        body.scrollTop = body.scrollHeight;
      }, 700);
    }

    /* 4. Interactive Ingestion Simulator Stream */
    const mockNames = ['Deepak Verma', 'Sneha Reddy', 'Aman Gupta', 'Divya Nair', 'Rohan Mehta', 'Kavita Joshi'];
    const mockSources = ['Meta Lead Ads', 'Google Call Sync', 'Offline QR Standee', 'Website Webhook'];
    function simulateNewLead() {
      const stream = document.getElementById('simIngestStream');
      if (!stream) return;
      const name = mockNames[Math.floor(Math.random() * mockNames.length)];
      const source = mockSources[Math.floor(Math.random() * mockSources.length)];
      const item = document.createElement('div');
      item.className = 'stream-item';
      item.innerHTML = `<div><strong>${name}</strong> <span style="color:#0ea5e9;">• ${source}</span></div><span class="font-mono" style="color:#10b981; font-weight:700;">DEDUP PASSED &rarr; Telecaller 0${Math.floor(Math.random()*4)+1}</span>`;
      stream.insertBefore(item, stream.firstChild);
      if (stream.children.length > 5) stream.removeChild(stream.lastChild);
    }

    /* 5. Interactive QR Token Simulator */
    let currentToken = 108;
    function generateNewToken() {
      currentToken++;
      const el = document.getElementById('simTokenDisplay');
      if (el) el.textContent = '#A-' + currentToken;
    }

    /* 6. 3D Mouse-Tracking Card Tilt */
    document.querySelectorAll('[data-tilt]').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -6;
        const rotateY = ((x - centerX) / centerX) * 6;
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)';
      });
    });

    /* 7. Interactive ROI Calculator */
    function updateRoiCalculator(leadsVal) {
      const leads = parseInt(leadsVal, 10);
      document.getElementById('roiLeadsDisplay').textContent = leads.toLocaleString('en-IN');
      const hours = Math.round(leads * 0.08);
      const extraStudents = Math.round(leads * 0.045);
      const revenue = (leads * 0.0045).toFixed(1);

      document.getElementById('roiHoursSaved').textContent = hours.toLocaleString('en-IN') + ' hrs';
      document.getElementById('roiExtraStudents').textContent = '+' + extraStudents.toLocaleString('en-IN');
      document.getElementById('roiRevenueProtected').textContent = '₹ ' + revenue + ' Lakhs';
    }

    /* 8. FAQ Accordion Toggle */
    function toggleFaq(btn) {
      const item = btn.closest('.faq-item');
      if (!item) return;
      const isActive = item.classList.contains('active');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('active'));
      if (!isActive) item.classList.add('active');
    }

    /* 9. Dual-Theme Engine & 3D Isometric Coin Sync */
    (function initThemeEngine() {
      const THEME_KEY = 'techpanda_theme';
      const themeToggleBtn = document.getElementById('theme-toggle');

      function applyTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
        try {
          localStorage.setItem(THEME_KEY, theme);
        } catch (e) {}
      }

      const saved = localStorage.getItem(THEME_KEY) || 'dark';
      applyTheme(saved);

      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
          const active = document.documentElement.getAttribute('data-theme') || 'dark';
          const target = active === 'dark' ? 'light' : 'dark';
          applyTheme(target);
        });
      }
    })();

    /* 10. Scroll-Driven Number Counter & Cinematic Viewport Reveal */
    (function initScrollCinematic() {
      const counters = document.querySelectorAll('.metric-number');
      if (!('IntersectionObserver' in window)) return;

      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const originalText = el.textContent.trim();
            // Match numbers
            const match = originalText.match(/([0-9.]+)/);
            if (match) {
              const targetVal = parseFloat(match[1]);
              const suffix = originalText.replace(match[1], '');
              let current = 0;
              const step = targetVal / 30;
              const timer = setInterval(() => {
                current += step;
                if (current >= targetVal) {
                  current = targetVal;
                  clearInterval(timer);
                }
                el.textContent = (targetVal % 1 === 0 ? Math.round(current) : current.toFixed(1)) + suffix;
              }, 30);
            }
            obs.unobserve(el);
          }
        });
      }, { threshold: 0.2 });

      counters.forEach(c => observer.observe(c));
    })();

  </script>
</body>
</html>
