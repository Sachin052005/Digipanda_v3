# Copy the lines you need into your .env (never commit .env). Restart the server after changes.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.ngrok-free.app,crm.techpanda.academy

# --- Database (MySQL) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=any-secret-word-you-choose
WHATSAPP_API_VERSION=v20.0
# Branch for new WhatsApp leads when the WhatsApp number has no CRM branch set (exact branch name)
WHATSAPP_DEFAULT_BRANCH=

# --- Facebook Lead Ads ---
FB_VERIFY_TOKEN=another-secret-word-you-choose
FB_APP_SECRET=
FB_PAGE_TOKEN=
FB_PAGE_ID=
FB_GRAPH_VERSION=v23.0
# Branch for new Facebook leads when the form has no branch question (exact branch name)
FB_DEFAULT_BRANCH=

# --- Call recordings (CRM Call Sync app) ---
# PRIVATE_MEDIA_ROOT=D:\crm_recordings

# --- Gmail SMTP Configuration ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=idpsachin@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=idpsachin@gmail.com
EMAIL_TIMEOUT=20
