{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Run Server (Port 8001)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "8001"],
      "django": true,
      "autoStartBrowser": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Django: Run Server (Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "8000"],
      "django": true,
      "autoStartBrowser": false,
      "cwd": "${workspaceFolder}"
    }
  ]
}
